<!--
    Helles Design: die gewohnte Windows-Optik. Hier stehen nur die Farben, die MusicWorker selbst festlegt
    (Akzente, Hinweisleisten), und die Knopf-Stile der Werkzeugleisten – alles andere kommt von Windows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Grundfarben (werden im hellen Design nur für Hinweise, Rahmen und gedimmten Text gebraucht) -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Foreground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Theme.ForegroundDim" Color="#666666" />
    <SolidColorBrush x:Key="Theme.Panel" Color="#F7F7F9" />
    <SolidColorBrush x:Key="Theme.PanelBorder" Color="#D9D9DE" />
    <SolidColorBrush x:Key="Theme.InfoBackground" Color="#E8F4FD" />
    <SolidColorBrush x:Key="Theme.InfoBorder" Color="#64B5F6" />
    <SolidColorBrush x:Key="Theme.WarnBackground" Color="#FFF4E5" />
    <SolidColorBrush x:Key="Theme.WarnBorder" Color="#FFB74D" />
    <SolidColorBrush x:Key="Theme.HintBackground" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Theme.HintBorder" Color="#D6DEE8" />
    <SolidColorBrush x:Key="Theme.KnobTrack" Color="#D5D7DD" />

    <!-- Akzentfarben (Kanäle L/R, Effektregler) -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#0078D4" />
    <SolidColorBrush x:Key="Theme.Blue" Color="#0277BD" />
    <SolidColorBrush x:Key="Theme.Pink" Color="#C2185B" />
    <SolidColorBrush x:Key="Theme.Orange" Color="#EF6C00" />
    <SolidColorBrush x:Key="Theme.Purple" Color="#6A1B9A" />
    <SolidColorBrush x:Key="Theme.Green" Color="#2E7D32" />
    <SolidColorBrush x:Key="Theme.Teal" Color="#00838F" />
    <SolidColorBrush x:Key="Theme.DeepOrange" Color="#D84315" />
    <SolidColorBrush x:Key="Theme.Red" Color="#C62828" />

    <!-- Knöpfe der Werkzeugleisten -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="ChannelToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
</ResourceDictionary>
