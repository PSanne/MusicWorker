                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="24" DefaultValue="6"
                                                               Value="{Binding SaturationDrive}" Accent="{DynamicResource Theme.Red}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding SaturationDrive, StringFormat={}+{0:0.#} dB}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Drive" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Dämpft die Höhen wie ein Tonband – Doppelklick für 40 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="40"
                                                               Value="{Binding SaturationWarmth}" Accent="{DynamicResource Theme.Orange}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding SaturationWarmth, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Wärme" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Anteil des gesättigten Klangs – Doppelklick für 100 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                               Value="{Binding SaturationMix}" Accent="{DynamicResource Theme.Blue}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding SaturationMix, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Anteil" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplySaturationCommand}"
                                                ToolTip="Bandsättigung fest in die Auswahl (oder die ganze Datei) einrechnen – danach ist sie ausgeschaltet." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Phaser" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsPhaserAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Phaser]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="192">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsPhaserEnabled}" ToolTip="Phaser ein/aus: wandernde Klangfarbe, der „schwebende“ Klang der 70er" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0" Columns="2" Style="{StaticResource PhaserDimWhenOff}">
                                            <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell der Effekt wandert – Doppelklick für 0,5 Hz">
                                                <controls:Knob Width="42" Height="42" Minimum="0.05" Maximum="5" DefaultValue="0.5"
                                                               Value="{Binding PhaserRate}" Accent="{DynamicResource Theme.Green}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding PhaserRate, StringFormat={}{0:0.00} Hz}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Tempo" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Wie weit der Effekt wandert – Doppelklick für 70 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                               Value="{Binding PhaserDepth}" Accent="{DynamicResource Theme.Purple}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding PhaserDepth, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Tiefe" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Rückkopplung: macht den Effekt deutlicher – Doppelklick für 40 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="90" DefaultValue="40"
                                                               Value="{Binding PhaserFeedback}" Accent="{DynamicResource Theme.Orange}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding PhaserFeedback, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Rückk." />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Anteil des Effekts – Doppelklick für 50 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                               Value="{Binding PhaserMix}" Accent="{DynamicResource Theme.Blue}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding PhaserMix, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Anteil" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyPhaserCommand}"
                                                ToolTip="Phaser fest in die Auswahl (oder die ganze Datei) einrechnen – danach ist er ausgeschaltet." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Tremolo" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsTremoloAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Tremolo]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="130">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsTremoloEnabled}" ToolTip="Tremolo ein/aus: die Lautstärke schwankt regelmäßig" />
                                            <CheckBox Margin="0,3,0,0" Content="Stereo-Pendel" IsChecked="{Binding TremoloStereo}" IsEnabled="{Binding IsStereo}"
                                                      ToolTip="Links und rechts abwechselnd laut – der Klang pendelt hin und her (nur bei Stereo)" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0" Columns="2" Style="{StaticResource TremoloDimWhenOff}">
                                            <StackPanel Margin="0,0,0,6" ToolTip="Wie oft pro Sekunde die Lautstärke schwankt – Doppelklick für 5 Hz">
                                                <controls:Knob Width="42" Height="42" Minimum="0.5" Maximum="15" DefaultValue="5"
                                                               Value="{Binding TremoloRate}" Accent="{DynamicResource Theme.Green}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding TremoloRate, StringFormat={}{0:0.0} Hz}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Tempo" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6" ToolTip="Wie stark die Lautstärke schwankt – Doppelklick für 50 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                               Value="{Binding TremoloDepth}" Accent="{DynamicResource Theme.Purple}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding TremoloDepth, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Tiefe" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyTremoloCommand}"
                                                ToolTip="Tremolo fest in die Auswahl (oder die ganze Datei) einrechnen – danach ist es ausgeschaltet." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Stereo-Breite" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsWidenerAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Breite]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="110">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsWidenerEnabled}" ToolTip="Stereo-Breite ein/aus: macht den Klang breiter oder schmaler (bis Mono)" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource Theme.ForegroundDim}" TextWrapping="Wrap" Text="Nur bei Stereo-Dateien"
                                                       Visibility="{Binding IsStereo, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0" Columns="1" Style="{StaticResource WidenerDimWhenOff}">
                                            <StackPanel Margin="0,0,0,6" ToolTip="0 % = Mono, 100 % = unverändert, 200 % = doppelt so breit – Doppelklick für 100 %">
                                                <controls:Knob Width="42" Height="42" Minimum="0" Maximum="200" DefaultValue="100"
                                                               Value="{Binding WidenerWidth}" Accent="{DynamicResource Theme.Blue}" />
                                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding WidenerWidth, StringFormat={}{0:0} %}" />
                                                <TextBlock Style="{StaticResource KnobLabel}" Text="Breite" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyWidenerCommand}"
                                                ToolTip="Stereo-Breite fest in die Auswahl (oder die ganze Datei) einrechnen – danach ist sie ausgeschaltet." />
                                    </Grid>
                                </GroupBox>
                            </WrapPanel>

                            <!-- Equalizer -->
                            <StackPanel Width="615" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <WrapPanel>
                                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Equalizer" />
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Ein" IsChecked="{Binding IsEqualizerEnabled}"
                                              ToolTip="Equalizer ein/aus – zum direkten Vorher-/Nachher-Vergleich" />
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="L/R getrennt" IsChecked="{Binding IsEqualizerPerChannel}"
                                              IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Pro-Kanal-EQ: links und rechts getrennt einstellen (nur bei Stereo)" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UsesPerChannelEqualizer, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock VerticalAlignment="Center" Text="Einstellen:" />
                                        <RadioButton Margin="6,0,0,0" GroupName="EqChannel" Content="L" FontWeight="Bold" Foreground="{DynamicResource Theme.Blue}"
                                                     Style="{StaticResource {x:Type ToggleButton}}" MinWidth="28"
                                                     IsChecked="{Binding EqualizerEditsLeft}" ToolTip="Regler zeigen den EQ des linken Kanals" />
                                        <RadioButton Margin="3,0,0,0" GroupName="EqChannel" Content="R" FontWeight="Bold" Foreground="{DynamicResource Theme.Pink}"
                                                     Style="{StaticResource {x:Type ToggleButton}}" MinWidth="28"
                                                     IsChecked="{Binding EqualizerEditsRight}" ToolTip="Regler zeigen den EQ des rechten Kanals" />
                                        <Button Margin="6,0,0,0" Padding="6,1" Content="Auf anderen Kanal kopieren"
                                                Command="{Binding CopyEqualizerToOtherChannelCommand}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,6">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Voreinstellung:" />
                                    <ComboBox Width="140" Margin="0,0,8,0" ItemsSource="{Binding CurrentEqualizer.Presets}"
                                              SelectedItem="{Binding CurrentEqualizer.SelectedPreset}" DisplayMemberPath="Name" />
                                    <Menu Margin="0,0,8,0" Background="Transparent" VerticalAlignment="Center">
                                        <MenuItem Header="Eigene ▾" Padding="4,1" ItemsSource="{Binding PresetMenus[Equalizer]}" ItemContainerStyle="{StaticResource PresetItem}"
                                                  ToolTip="Eigene Equalizer-Einstellungen speichern und laden" />
                                    </Menu>
                                    <Button Margin="0,0,8,0" Padding="6,1" Content="Alle auf 0" Command="{Binding CurrentEqualizer.ResetCommand}" />
                                    <Button Margin="0,0,8,0" Padding="6,1" FontWeight="SemiBold" Content="In Audio übernehmen"
                                            Command="{Binding ApplyEqualizerCommand}"
                                            ToolTip="Klang fest in die Auswahl (oder die ganze Datei) einrechnen – bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Regler auf 0." />
                                    <CheckBox VerticalAlignment="Center" Content="Übersteuerung verhindern" IsChecked="{Binding EqualizerPreventClipping}"
                                              ToolTip="Gilt für alle Effekte: beim Übernehmen und Exportieren den Pegel bei Bedarf auf -1 dB absenken." />
                                </WrapPanel>

                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Text="Live" />
                                    <controls:SpectrumView Grid.Row="0" Grid.Column="2" Width="510" Height="120" Margin="0,0,0,4"
                                                           Spectra="{Binding Spectra}"
                                                           EqualizerCurve="{Binding EqualizerCurve}"
                                                           EqualizerCurveRight="{Binding EqualizerCurveRight}"
                                                           ActiveCurve="{Binding ActiveEqualizerCurve}"
                                                           ToolTip="Spektrum der Wiedergabe nach allen Effekten (Stereo: blau = links, rosa = rechts) · Linien: EQ-Kurve(n)" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,2" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                               Text="{Binding EqualizerTargetText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Blue}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Pink}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Width="52" Style="{StaticResource EqDimWhenOff}"
                                                ToolTip="Vorverstärkung vor dem Equalizer – Doppelklick setzt auf 0 dB">
                                        <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding CurrentEqualizer.PreampDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                                        <Slider Style="{StaticResource EqSlider}" Value="{Binding CurrentEqualizer.PreampDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                        <TextBlock Style="{StaticResource EqBandLabel}" FontWeight="SemiBold" Text="Pegel" />
                                    </StackPanel>

                                    <Border Grid.Row="2" Grid.Column="1" Width="1" Margin="6,0" Background="{DynamicResource Theme.PanelBorder}" />

                                    <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding CurrentEqualizer.Bands}" Focusable="False"
                                                  Style="{StaticResource EqDimWhenOff}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="34" ToolTip="{Binding ToolTip}">
                                                    <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                                                    <Slider Style="{StaticResource EqSlider}" Value="{Binding GainDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                                    <TextBlock Style="{StaticResource EqBandLabel}" Text="{Binding Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Row="2" Grid.Column="3" Margin="5,18,0,0" Height="150" VerticalAlignment="Top">
                                        <TextBlock VerticalAlignment="Top" FontSize="10" Foreground="Gray" Text="+12" />
                                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="Gray" Text="0 dB" />
                                        <TextBlock VerticalAlignment="Bottom" FontSize="10" Foreground="Gray" Text="-12" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="80" />
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition">
                                            <Setter Property="Height" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpectrogramVisible}" Value="True">
                                                    <Setter Property="Height" Value="*" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                            </Grid.RowDefinitions>
                            <controls:WaveformView x:Name="Waveform"
                                                   Buffer="{Binding Buffer}"
                                                   Selection="{Binding Selection}"
                                                   PlayheadFrame="{Binding PlayheadFrame}"
                                                   SeekCommand="{Binding SeekCommand}"
                                                   ActiveChannels="{Binding ActiveChannels}"
                                                   MutedChannels="{Binding MutedChannels}"
                                                   FollowPlayhead="{Binding IsPlaying}"
                                                   Markers="{Binding Markers}"
                                                   MarkerCommand="{Binding EditorMarkerCommand}" />
                            <Border Grid.Row="1" BorderBrush="#3A3E48" BorderThickness="0,1,0,0"
                                    Visibility="{Binding IsSpectrogramVisible, Converter={StaticResource BoolToVisibility}}">
                                <controls:SpectrogramView x:Name="Spectrogram"
                                                          Buffer="{Binding Buffer}"
                                                          FrequencyBand="{Binding SpectralBand}"
                                                          Selection="{Binding Selection}"
                                                          PlayheadFrame="{Binding PlayheadFrame}"
                                                          SeekCommand="{Binding SeekCommand}"
                                                          ToolTip="Spektrogramm: Zeit waagerecht, Frequenz senkrecht, Helligkeit = Lautstärke. Strg+Ziehen markiert einen Frequenzbereich (z. B. ein Klingeln) für „Reparieren → Störgeräusch entfernen“." />
                            </Border>
                        </Grid>

                        <Border Background="#AA000000"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="260" Height="6" IsIndeterminate="True" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Mischpult  ">
                <DockPanel>
                    <!-- Mischpult-Werkzeugleiste -->
                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                        <ToolBar>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding TransportSkipBackCommand}" ToolTip="5 Sekunden zurück (Strg+←)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9E;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.PlayCommand}" ToolTip="Projekt abspielen (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.PauseCommand}" ToolTip="Pause (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.StopCommand}" ToolTip="Stopp (Esc) – zurück zur Startposition">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding TransportSkipForwardCommand}" ToolTip="5 Sekunden vor (Strg+→)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9D;" />
                            </Button>
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" IsChecked="{Binding Mixer.IsRecording, Mode=OneWay}"
                                          Command="{Binding Mixer.ToggleRecordCommand}"
                                          ToolTip="Aufnahme starten/beenden (Strg+R) – auf die scharfgeschalteten Spuren (●), sonst auf eine neue Spur">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#E53935" />
                                    <TextBlock Margin="4,0,0,0" Text="Aufnahme" />
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock Margin="8,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding Mixer.PositionText}" />
                        </ToolBar>
                        <ToolBar Band="1">
                            <ToggleButton Style="{DynamicResource ChannelToggle}" IsChecked="{Binding Mixer.IsMetronomeEnabled}" ToolTip="Metronom beim Abspielen und Aufnehmen (nicht im Mixdown)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" />
                                    <TextBlock Margin="4,0,0,0" Text="Metronom" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" Content="Vorzähler" IsChecked="{Binding Mixer.IsCountInEnabled}"
                                          ToolTip="Vor der Aufnahme einen Takt einzählen" />
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" Content="Punch-In" IsChecked="{Binding Mixer.IsPunchEnabled}"
                                          ToolTip="Neuaufnahme nur im Loop-Bereich (Umschalt+Ziehen): davor läuft ein Takt Vorlauf, außerhalb bleibt alles unverändert. Mit eingeschaltetem Loop entsteht bei jedem Durchgang ein neuer Take." />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Eingang" />
                            <ComboBox Width="170" VerticalAlignment="Center" ItemsSource="{Binding Mixer.InputDevices}" SelectedItem="{Binding Mixer.SelectedInputDevice}"
                                      ToolTip="Aufnahmegerät (Mikrofon, Line-In, Audio-Interface)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.RefreshInputDevicesCommand}" ToolTip="Liste der Aufnahmegeräte aktualisieren">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                            </Button>
                            <ProgressBar Width="70" Height="8" Margin="4,0" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding Mixer.InputLevel, Mode=OneWay}"
                                         Foreground="#66BB6A" Background="#15171C" ToolTip="Eingangspegel (sichtbar, sobald eine Audiospur scharfgeschaltet ist)" />
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" IsChecked="{Binding Mixer.IsInputMonitoringEnabled}"
                                          ToolTip="Mithören: Den Eingang (Mikrofon, Gitarre …) beim Aufnehmen über Kopfhörer hören. Lautstärke = Fader der scharfgeschalteten Spur. Bitte Kopfhörer benutzen, sonst pfeift es.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F6;" />
                                    <TextBlock Margin="4,0,0,0" Text="Mithören" />
                                </StackPanel>
                            </ToggleButton>
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Treiber" />
                            <ComboBox Width="190" VerticalAlignment="Center" ItemsSource="{Binding Mixer.AudioDriverChoices}" SelectedItem="{Binding Mixer.SelectedAudioDriver}"
                                      ToolTip="Wie MusicWorker mit der Soundkarte spricht. Standard funktioniert überall; WASAPI und besonders WASAPI exklusiv oder ASIO (Audio-Interfaces) verringern die Verzögerung beim Aufnehmen und Mithören deutlich." />
                            <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="Puffer" />
