                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding JumpCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding Index}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </Menu>
                        </ToolBar>
                        <ToolBar Band="1">
