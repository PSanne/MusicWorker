                                                            <StackPanel ToolTip="Tiefen ±12 dB (120 Hz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqLow}" Accent="#E57373" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Tief" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Mitten ±12 dB (1 kHz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqMid}" Accent="#FFD54F" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Mitte" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Höhen ±12 dB (8 kHz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqHigh}" Accent="#4FC3F7" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Höhe" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <UniformGrid Margin="0,4,0,0" Columns="2">
