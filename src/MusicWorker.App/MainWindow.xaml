                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="60" Value="{Binding RoomSize}" Accent="{DynamicResource Theme.Purple}" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Raum" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Dämpfung – Doppelklick für 40 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="40" Value="{Binding Damping}" Accent="{DynamicResource Theme.Orange}" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Dämpf." />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Strip}" BorderBrush="#FFB74D" Background="#33302A" DataContext="{Binding Mixer.EchoBus}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StripTitle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Rückweg" />
                                        <Slider Style="{StaticResource StripFader}" Margin="0,10,0,0" Height="110" Value="{Binding ReturnDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                ToolTip="Lautstärke des Echo-Anteils, der zur Summe zurückkommt" />
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <StackPanel ToolTip="Verzögerung links in ms – Doppelklick für 375 ms">
                                                <controls:Knob Width="30" Height="30" Minimum="20" Maximum="2000" DefaultValue="375" Value="{Binding TimeLeft}" Accent="#4FC3F7" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Zeit L" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Verzögerung rechts in ms – Doppelklick für 500 ms">
                                                <controls:Knob Width="30" Height="30" Minimum="20" Maximum="2000" DefaultValue="500" Value="{Binding TimeRight}" Accent="#F06292" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Zeit R" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Rückkopplung – Doppelklick für 35 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="90" DefaultValue="35" Value="{Binding Feedback}" Accent="{DynamicResource Theme.Purple}" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Rückk." />
                                            </StackPanel>
                                            <StackPanel ToolTip="Dämpfung – Doppelklick für 40 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="40" Value="{Binding Damping}" Accent="{DynamicResource Theme.Orange}" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Dämpf." />
                                            </StackPanel>
                                        </UniformGrid>
                                        <CheckBox Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#C8CCD4" FontSize="11" Content="Ping-Pong" IsChecked="{Binding PingPong}" />
                                    </StackPanel>
                                </Border>
                                <Rectangle Width="1" Margin="4,0,10,0" Fill="#3A3E48" />
                                <Border Style="{StaticResource Strip}" Width="110" BorderBrush="#FF5252" Background="#33282A">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StripTitle}" Text="Master" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Summe" />
                                        <StackPanel Margin="0,44,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding Mixer.MasterMeterLeft, Mode=OneWay}" ToolTip="Pegel links" />
                                            <ProgressBar Style="{StaticResource Meter}" Margin="2,0,0,0" Value="{Binding Mixer.MasterMeterRight, Mode=OneWay}" ToolTip="Pegel rechts" />
                                            <Slider Style="{StaticResource StripFader}" Value="{Binding Mixer.MasterDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                    ToolTip="Master-Fader: Gesamtlautstärke" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding Mixer.MasterVolumeText}" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,0" Text="Lautheit (3 s)"
                                                   ToolTip="Empfundene Lautheit der letzten 3 Sekunden in LUFS. Zum Vergleich: Spotify/YouTube -14, Podcast -16." />
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding Mixer.LoudnessText}"
                                                   ToolTip="Empfundene Lautheit der letzten 3 Sekunden in LUFS. Zum Vergleich: Spotify/YouTube -14, Podcast -16." />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,8,0,2" Text="Master-EQ" />
                                        <UniformGrid Columns="3">
                                            <StackPanel ToolTip="Tiefen der Summe ±12 dB (120 Hz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqLow}" Accent="#E57373" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Tief" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Mitten der Summe ±12 dB (1 kHz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqMid}" Accent="#FFD54F" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Mitte" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Höhen der Summe ±12 dB (8 kHz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqHigh}" Accent="#4FC3F7" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Höhe" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel Margin="0,4,0,0" ToolTip="Summen-Kompressor: verdichtet den Gesamtklang (0 % = aus) – Doppelklick = aus">
                                            <controls:Knob Width="26" Height="26" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding Mixer.MasterCompression}" Accent="#FF8A65" />
                                            <TextBlock Style="{StaticResource StripSmall}" Text="Komp." />
                                        </StackPanel>
                                        <CheckBox Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#C8CCD4" FontSize="11" Content="Limiter"
                                                  IsChecked="{Binding Mixer.MasterLimiter}" ToolTip="Begrenzer: verhindert, dass die Summe übersteuert (empfohlen)" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Spuransicht -->
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1B1D23">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Background="#22252C">
                                    <Border Height="22" Background="#25282E" BorderBrush="#30343D" BorderThickness="0,0,1,0">
                                        <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0AA" Text="Spuren" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Mixer.Tracks}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding Height}" Padding="8,6" BorderBrush="#30343D" BorderThickness="0,0,1,1" Background="#22252C"
                                                        AllowDrop="True" Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="OnTrackHeaderMouseDown" MouseMove="OnTrackHeaderMouseMove"
                                                        DragOver="OnTrackHeaderDragOver" Drop="OnTrackHeaderDrop"
                                                        ToolTip="Spur ziehen = Reihenfolge ändern · Rechtsklick = Farbe, Höhe, verschieben">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Nach _oben" Command="{Binding MoveUpCommand}" />
                                                            <MenuItem Header="Nach _unten" Command="{Binding MoveDownCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="_Farbe" ItemsSource="{x:Static vm:TrackViewModel.ColorChoices}">
                                                                <MenuItem.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Rectangle Width="16" Height="10" Margin="0,0,8,0" Fill="{Binding Color}" RadiusX="2" RadiusY="2" />
                                                                            <TextBlock Text="{Binding Name}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </MenuItem.ItemTemplate>
                                                                <MenuItem.ItemContainerStyle>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="Command" Value="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        <Setter Property="CommandParameter" Value="{Binding Color}" />
                                                                    </Style>
                                                                </MenuItem.ItemContainerStyle>
                                                            </MenuItem>
                                                            <MenuItem Header="_Höhe">
                                                                <MenuItem Header="_Klein" Command="{Binding SetHeightCommand}" CommandParameter="50" />
                                                                <MenuItem Header="_Normal" Command="{Binding SetHeightCommand}" CommandParameter="76" />
                                                                <MenuItem Header="_Groß" Command="{Binding SetHeightCommand}" CommandParameter="120" />
                                                                <MenuItem Header="_Sehr groß" Command="{Binding SetHeightCommand}" CommandParameter="180" />
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <DockPanel>
                                                        <Rectangle DockPanel.Dock="Left" Width="4" Fill="{Binding Color}" RadiusX="2" RadiusY="2" />
                                                        <StackPanel Margin="8,0,0,0">
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Right" Width="22" Height="18" Padding="0" Focusable="False" IsChecked="{Binding IsArmed}"
                                                                              ToolTip="Für die Aufnahme scharfschalten (Audiospur: Eingang, Notenspur: MIDI-Keyboard/Tastatur)">
                                                                    <Ellipse Width="9" Height="9" Fill="#E53935" />
                                                                </ToggleButton>
                                                                <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding InstrumentName}" />
                                                            </DockPanel>
                                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                                <ToggleButton Style="{StaticResource StripToggle}" Content="M" IsChecked="{Binding Mute}" ToolTip="Stumm (Mute)" />
                                                                <ToggleButton Style="{StaticResource StripToggle}" Margin="4,0,0,0" Content="S" IsChecked="{Binding Solo}" ToolTip="Solo" />
                                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0AA" FontFamily="Consolas"
                                                                           Text="{Binding VolumeText}"
                                                                           Visibility="{Binding DataContext.Mixer.IsEnvelopeMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                <ComboBox Margin="6,0,0,0" Width="78" FontSize="10" VerticalAlignment="Center"
                                                                          ItemsSource="{Binding AutomationChoices}" DisplayMemberPath="Name"
                                                                          SelectedValuePath="Target" SelectedValue="{Binding ShownAutomation}"
                                                                          ToolTip="Welche Hüllkurve dieser Spur gezeigt und bearbeitet wird"
                                                                          Visibility="{Binding DataContext.Mixer.IsEnvelopeMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <controls:TimelineView x:Name="Timeline" Grid.Column="1"
                                                       Tracks="{Binding Mixer.Tracks}"
                                                       Version="{Binding Mixer.TimelineVersion}"
                                                       PlayheadFrame="{Binding Mixer.PlayheadFrame}"
                                                       SampleRate="{Binding Mixer.SampleRate}"
                                                       SelectedClip="{Binding Mixer.SelectedClip}"
                                                       FollowPlayhead="{Binding Mixer.IsPlaying}"
                                                       SeekCommand="{Binding Mixer.SeekCommand}"
                                                       MoveClipCommand="{Binding Mixer.MoveClipCommand}"
                                                       SelectClipCommand="{Binding Mixer.SelectClipCommand}"
                                                       OpenClipCommand="{Binding Mixer.OpenClipInEditorCommand}"
                                                       SetLoopCommand="{Binding Mixer.SetLoopRangeCommand}"
                                                       Bpm="{Binding Mixer.Bpm}"
                                                       TempoMap="{Binding Mixer.Tempo}"
                                                       BeatsPerBar="{Binding Mixer.BeatsPerBar}"
                                                       ShowGrid="{Binding Mixer.ShowGrid}"
                                                       IsLooping="{Binding Mixer.IsLooping}"
                                                       LoopStart="{Binding Mixer.LoopStart}"
                                                       LoopEnd="{Binding Mixer.LoopEnd}"
                                                       IsEnvelopeMode="{Binding Mixer.IsEnvelopeMode}"
                                                       EditAutomationCommand="{Binding Mixer.EditAutomationCommand}"
                                                       CreateClipCommand="{Binding Mixer.CreateClipAtCommand}"
                                                       RecordingStartFrame="{Binding Mixer.RecordingStartFrame}"
                                                       Markers="{Binding Mixer.Markers}"
                                                       MarkerCommand="{Binding Mixer.MixerMarkerCommand}"
                                                       SelectedClips="{Binding Mixer.SelectedClips}"
                                                       ToggleClipSelectionCommand="{Binding Mixer.ToggleClipSelectionCommand}"
                                                       SelectClipsCommand="{Binding Mixer.SelectClipsCommand}"
                                                       MoveClipsCommand="{Binding Mixer.MoveClipsCommand}"
                                                       ClipFadeCommand="{Binding Mixer.SetClipFadeCommand}">
                                    <controls:TimelineView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Kopieren" Command="{Binding Mixer.CopyClipsCommand}" InputGestureText="Strg+C" />
                                            <MenuItem Header="_Ausschneiden" Command="{Binding Mixer.CutClipsCommand}" InputGestureText="Strg+X" />
                                            <MenuItem Header="_Einfügen an der Abspielposition" Command="{Binding Mixer.PasteClipsCommand}" InputGestureText="Strg+V" />
                                            <MenuItem Header="_Duplizieren (direkt dahinter)" Command="{Binding Mixer.DuplicateClipsCommand}" InputGestureText="Strg+D" />
                                            <Separator />
                                            <MenuItem Header="Ein-/Ausblenden _zurücksetzen" Command="{Binding Mixer.ResetFadesCommand}" />
                                            <MenuItem Header="Im _Editor öffnen" Command="{Binding Mixer.OpenSelectedClipInEditorCommand}" />
                                            <Separator />
                                            <MenuItem Header="_Löschen" Command="{Binding Mixer.DeleteSelectedClipCommand}" InputGestureText="Entf" />
                                        </ContextMenu>
                                    </controls:TimelineView.ContextMenu>
                                </controls:TimelineView>
                            </Grid>
                        </ScrollViewer>

                        <Border Background="#AA000000" Visibility="{Binding Mixer.IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="260" Height="6" IsIndeterminate="True" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding Mixer.StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Noten  ">
                <DockPanel>
                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                        <ToolBar>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.PlayCommand}" ToolTip="Projekt ab der Abspielposition abspielen (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.PauseCommand}" ToolTip="Pause (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.StopCommand}" ToolTip="Stopp (Esc)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                            </Button>
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" IsChecked="{Binding Mixer.IsRecording, Mode=OneWay}"
                                          Command="{Binding Mixer.ToggleRecordCommand}"
                                          ToolTip="Echtzeit-Aufnahme (Strg+R): Notenspur im Mischpult scharfschalten (●) und auf der Tastatur bzw. dem MIDI-Keyboard spielen">
                                <Ellipse Width="11" Height="11" Fill="#E53935" />
                            </ToggleButton>
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" IsChecked="{Binding Mixer.IsMetronomeEnabled}" ToolTip="Metronom">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" />
                            </ToggleButton>
                            <TextBlock Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Notes.Title}" />
                        </ToolBar>
                        <ToolBar>
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Instrument" />
                            <ComboBox Width="140" VerticalAlignment="Center" ItemsSource="{Binding Notes.BuiltInChoices}" SelectedItem="{Binding Notes.SelectedBuiltIn}"
                                      IsEnabled="{Binding Notes.HasClip}" ToolTip="Eingebautes Instrument der Spur (braucht keine Dateien)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource InstrumentName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.LoadSoundFontCommand}" Content="SoundFont …" IsEnabled="{Binding Notes.HasClip}"
                                    ToolTip="Eigene Klänge aus einer SoundFont-Datei (.sf2) laden – z. B. „GeneralUser GS“ oder „FluidR3 GM“" />
                            <ComboBox Width="200" VerticalAlignment="Center" ItemsSource="{Binding Notes.Presets}" SelectedItem="{Binding Notes.SelectedPreset}"
                                      Visibility="{Binding Notes.HasSoundFont, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="{Binding Notes.SoundFontName}" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.UseBuiltInCommand}" Content="Eingebaut"
                                    Visibility="{Binding Notes.HasSoundFont, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Zurück zum eingebauten Instrument" />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="MIDI-Eingang" />
                            <ComboBox Width="150" VerticalAlignment="Center" ItemsSource="{Binding Notes.MidiInputs}" SelectedItem="{Binding Notes.SelectedMidiInput}"
                                      ToolTip="Angeschlossenes MIDI-Keyboard zum Spielen und für die Schritt-Aufnahme" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.RefreshMidiInputsCommand}" ToolTip="Liste der MIDI-Geräte aktualisieren">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                            </Button>
                        </ToolBar>
                        <ToolBar Band="1">
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Raster" />
                            <ComboBox Width="58" VerticalAlignment="Center" ItemsSource="{Binding Notes.GridChoices}" DisplayMemberPath="Name" SelectedItem="{Binding Notes.Grid}"
                                      ToolTip="Notenwert für neue Noten, Einrasten und Quantisieren" />
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" Content="Triole" IsChecked="{Binding Notes.IsTriplet}" ToolTip="Triolen-Raster (drei Noten im Platz von zwei)" />
                            <ToggleButton Style="{DynamicResource ChannelToggle}" Margin="4,0,0,0" Content="Einrasten" IsChecked="{Binding Notes.IsSnapEnabled}" ToolTip="Noten rasten beim Setzen und Verschieben auf das Raster ein" />
                            <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="Länge" />
                            <TextBox Width="40" VerticalAlignment="Center" HorizontalContentAlignment="Right" Text="{Binding Notes.LengthBarsText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnCommitTextBoxKeyDown" IsEnabled="{Binding Notes.HasClip}" ToolTip="Länge des Notenclips in Takten (mit Eingabetaste übernehmen)" />
                            <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" Text="Takte" />
                            <ToggleButton Style="{DynamicResource ChannelToggle}" IsChecked="{Binding Notes.IsStepRecording}" IsEnabled="{Binding Notes.HasClip}"
                                          ToolTip="Schritt-Aufnahme: Gespielte Töne (Bildschirmtastatur, Computertastatur oder MIDI-Keyboard) werden am grünen Cursor eingefügt, danach rückt er einen Rasterschritt weiter. Klick ins Taktlineal setzt den Cursor.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#E53935" />
                                    <TextBlock Margin="4,0,0,0" Text="Schritt-Aufnahme" />
                                </StackPanel>
                            </ToggleButton>
                            <Separator />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.UndoCommand}" ToolTip="Notenbearbeitung rückgängig (Strg+Z)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.RedoCommand}" ToolTip="Wiederholen (Strg+Y)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.SelectAllCommand}" Content="Alle" ToolTip="Alle Noten auswählen (Strg+A)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.DeleteSelectedCommand}" ToolTip="Gewählte Noten löschen (Entf)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                            </Button>
                            <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundDim}" Text="{Binding Notes.SelectionText}" />
                        </ToolBar>
                        <ToolBar Band="2">
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.QuantizeCommand}" Content="Quantisieren …"
                                    ToolTip="Notenanfänge auf das Raster rücken (wirkt auf die Auswahl, ohne Auswahl auf alle Noten)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.HumanizeCommand}" Content="Humanisieren …"
                                    ToolTip="Timing und Anschlag leicht zufällig verändern – klingt lebendiger" />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Transponieren" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.TransposeCommand}" CommandParameter="1" Content="+1" ToolTip="Einen Halbton höher (Pfeil hoch)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.TransposeCommand}" CommandParameter="-1" Content="−1" ToolTip="Einen Halbton tiefer (Pfeil runter)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.TransposeCommand}" CommandParameter="12" Content="+Okt" ToolTip="Eine Oktave höher (Umschalt+Pfeil hoch)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.TransposeCommand}" CommandParameter="-12" Content="−Okt" ToolTip="Eine Oktave tiefer (Umschalt+Pfeil runter)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.TransposeByCommand}" Content="…" ToolTip="Um beliebig viele Halbtöne transponieren" />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Länge" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.ScaleLengthCommand}" CommandParameter="0.5" Content="×½" ToolTip="Notenlängen halbieren (kürzer, staccato)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.ScaleLengthCommand}" CommandParameter="2" Content="×2" ToolTip="Notenlängen verdoppeln" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.LengthToGridCommand}" Content="= Raster" ToolTip="Alle Längen auf den Rasterwert setzen" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.LegatoCommand}" Content="Legato" ToolTip="Jede Note klingt bis zur nächsten (gebunden)" />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Anschlag" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.SetVelocityToCommand}" Content="Setzen …" ToolTip="Anschlagstärke festlegen (einzelne Noten im Anschlag-Feld unten ziehen)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.CrescendoCommand}" CommandParameter="up" Content="Cresc." ToolTip="Crescendo: allmählich lauter" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.CrescendoCommand}" CommandParameter="down" Content="Decresc." ToolTip="Decrescendo: allmählich leiser" />
                            <Separator />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.SplitVoicesCommand}" Content="Stimmen aufteilen …"
                                    ToolTip="Gleichzeitige Noten auf mehrere Spuren verteilen (z. B. Melodie und Begleitung)" />
                            <Separator />
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Komponieren" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.InsertChordCommand}" Content="Akkord …"
                                    ToolTip="Einen Akkord (z. B. Am, G7) am grünen Cursor einfügen – danach rückt der Cursor weiter" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.InsertProgressionCommand}" Content="Akkordfolge …"
                                    ToolTip="Eine ganze Akkordfolge in einer Tonart einfügen (Pop, Blues, Jazz …)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.ArpeggiateCommand}" Content="Arpeggiator …"
                                    ToolTip="Akkorde als gebrochene Akkorde spielen (aufwärts, abwärts, Alberti …)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.EditDrumsCommand}" Content="Schlagzeug-Raster …"
                                    ToolTip="Schlagzeug-Rhythmus im Raster anklicken oder einen fertigen Rhythmus wählen (Rock, Pop, Hip-Hop …)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Notes.ShowSheetMusicCommand}" Content="Notenblatt …"
                                    ToolTip="Alle Notenspuren als Noten anzeigen – zum Drucken oder als PDF speichern" />
                            <Separator />
                            <Button Style="{DynamicResource ToolButton}" Click="OnPianoRollZoomInClick" ToolTip="Vergrößern (Strg+Mausrad)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Click="OnPianoRollZoomOutClick" ToolTip="Verkleinern (Strg+Mausrad)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" />
                            </Button>
                            <Button Style="{DynamicResource ToolButton}" Click="OnPianoRollZoomFitClick" ToolTip="Ganzen Clip anzeigen">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                            </Button>
                        </ToolBar>
                    </ToolBarTray>

                    <!-- Bildschirmtastatur -->
                    <Border DockPanel.Dock="Bottom" Background="#1E2026" BorderBrush="#3A3E48" BorderThickness="0,1,0,0" Padding="8,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="120" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Foreground="#C8CCD4" FontWeight="SemiBold" Text="Tastatur" />
                                <TextBlock Margin="0,2,0,6" Foreground="#9AA0AA" FontSize="11" Text="{Binding Notes.OctaveText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Padding="8,2" Content="◀ Oktave" Command="{Binding Notes.OctaveDownCommand}" Focusable="False" />
                                    <Button Margin="4,0,0,0" Padding="8,2" Content="▶" Command="{Binding Notes.OctaveUpCommand}" Focusable="False" ToolTip="Oktave höher" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="#80868F" FontSize="10" TextWrapping="Wrap"
                                           Text="Computertastatur: Y–M und Q–U spielen mit." />
                            </StackPanel>
                            <controls:PianoKeyboardView Height="96" LowestKey="{Binding Notes.LowestKey}" PressedKeys="{Binding Notes.PressedKeys}"
                                                        PlayCommand="{Binding Notes.PlayKeyCommand}" ReleaseCommand="{Binding Notes.ReleaseKeyCommand}" />
                        </DockPanel>
                    </Border>

                    <!-- Piano-Roll -->
                    <Grid>
                        <controls:PianoRollView x:Name="PianoRoll"
                                                Document="{Binding Notes.Clip}"
                                                Notes="{Binding Notes.Notes}"
                                                Selection="{Binding Notes.Selection}"
                                                LengthTicks="{Binding Notes.LengthTicks}"
                                                GridTicks="{Binding Notes.GridTicks}"
                                                BeatsPerBar="{Binding Notes.BeatsPerBar}"
                                                PlayheadTick="{Binding Notes.PlayheadTick}"
                                                StepCursorTick="{Binding Notes.StepCursorTick}"
                                                ShowStepCursor="{Binding Notes.IsStepRecording}"
                                                IsDrums="{Binding Notes.IsDrums}"
                                                Version="{Binding Notes.Version}"
                                                EditCommand="{Binding Notes.EditCommand}" />
                        <Border Background="#E61B1D23" Visibility="{Binding Notes.HasClip, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                                <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Noch kein Notenclip geöffnet" />
                                <TextBlock Margin="0,8,0,14" Foreground="#9AA0AA" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="Lege eine Notenspur an oder importiere eine MIDI-Datei. Einen vorhandenen Notenclip öffnest du im Mischpult per Doppelklick. Die Bildschirmtastatur unten spielt schon jetzt." />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Padding="12,4" Content="+ Notenspur" Command="{Binding Mixer.AddNoteTrackCommand}" />
                                    <Button Margin="8,0,0,0" Padding="12,4" Content="MIDI importieren …" Command="{Binding Mixer.ImportMidiCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
