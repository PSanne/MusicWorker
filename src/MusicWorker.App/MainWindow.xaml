                                    ToolTip="Alle Clips der Spur lückenlos hintereinanderlegen – auf Wunsch mit Überblendung (Mixtape)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.BounceCommand}" Content="Zusammenmischen"
                                    ToolTip="Clip-Mischung: alle hörbaren Spuren zu einer neuen Spur mischen (Quellen werden stummgeschaltet)" />
                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.SeparateClipVocalsCommand}" Content="Gesang trennen (KI)"
                                    ToolTip="Gesang und Begleitung des gewählten Clips per KI auf zwei neue Spuren trennen (das Original wird stummgeschaltet)" />
