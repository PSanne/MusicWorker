<Window x:Class="MusicWorker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicWorker.App.Controls"
        xmlns:local="clr-namespace:MusicWorker.App.Helpers"
        xmlns:vm="clr-namespace:MusicWorker.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1320" Height="880" MinWidth="1240" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Symbole aus der Windows-Schrift „Segoe MDL2 Assets“ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ChannelToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ReverbDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReverbEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KnobValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="KnobLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Equalizer-Regler -->
        <Style x:Key="EqDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEqualizerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="TickPlacement" Value="Both" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EqValueLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="EqBandLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ExportCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding TrimCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ToggleEqualizerCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding SkipForwardCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding SkipBackCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Öffnen …" Command="{Binding OpenCommand}" InputGestureText="Strg+O" />
                <MenuItem Header="_Zuletzt geöffnet" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Exportieren …" Command="{Binding ExportCommand}" InputGestureText="Strg+E" />
                <MenuItem Header="_Kanäle als Mono-Dateien exportieren …" Command="{Binding ExportChannelsCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExitClick" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Strg+Z" />
                <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Strg+Y" />
                <Separator />
                <MenuItem Header="_Ausschneiden" Command="{Binding CutCommand}" InputGestureText="Strg+X" />
                <MenuItem Header="_Kopieren" Command="{Binding CopyCommand}" InputGestureText="Strg+C" />
                <MenuItem Header="_Einfügen" Command="{Binding PasteCommand}" InputGestureText="Strg+V" />
                <MenuItem Header="_Löschen" Command="{Binding DeleteCommand}" InputGestureText="Entf" />
                <Separator />
                <MenuItem Header="Auf Auswahl _zuschneiden" Command="{Binding TrimCommand}" InputGestureText="Strg+T" />
                <MenuItem Header="Alles a_uswählen" Command="{Binding SelectAllCommand}" InputGestureText="Strg+A" />
                <Separator />
                <MenuItem Header="_Stille einfügen …" Command="{Binding InsertSilenceCommand}" />
                <Separator />
                <MenuItem Header="Ka_näle">
                    <MenuItem Header="Effekte auf _linken Kanal" IsCheckable="True" IsChecked="{Binding EditLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <MenuItem Header="Effekte auf _rechten Kanal" IsCheckable="True" IsChecked="{Binding EditRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <Separator />
                    <MenuItem Header="Nur linken Kanal _behalten (Mono)" Command="{Binding KeepLeftChannelCommand}" />
                    <MenuItem Header="Nur rechten Kanal b_ehalten (Mono)" Command="{Binding KeepRightChannelCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Wiedergabe">
                <MenuItem Header="_Abspielen / Pause" Command="{Binding TogglePlayPauseCommand}" InputGestureText="Leertaste" />
                <MenuItem Header="_Stopp" Command="{Binding StopCommand}" InputGestureText="Esc" />
                <MenuItem Header="5 Sekunden _vor" Command="{Binding SkipForwardCommand}" InputGestureText="Strg+→" />
                <MenuItem Header="5 Sekunden _zurück" Command="{Binding SkipBackCommand}" InputGestureText="Strg+←" />
                <Separator />
                <MenuItem Header="_Linken Kanal hören" IsCheckable="True" IsChecked="{Binding HearLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                <MenuItem Header="_Rechten Kanal hören" IsCheckable="True" IsChecked="{Binding HearRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
            </MenuItem>
            <MenuItem Header="E_ffekte">
                <MenuItem Header="_Lautstärke ändern …" Command="{Binding ChangeGainCommand}" />
                <MenuItem Header="_Normalisieren" Command="{Binding NormalizeCommand}" />
                <MenuItem Header="_Equalizer in Audio übernehmen" Command="{Binding ApplyEqualizerCommand}" />
                <MenuItem Header="_Hall in Audio übernehmen" Command="{Binding ApplyReverbCommand}" />
                <MenuItem Header="_Tempo &amp; Tonhöhe …" Command="{Binding TempoPitchCommand}" />
                <Separator />
                <MenuItem Header="_Einblenden (Fade In)" Command="{Binding FadeInCommand}" />
                <MenuItem Header="_Ausblenden (Fade Out)" Command="{Binding FadeOutCommand}" />
                <Separator />
                <MenuItem Header="_Umkehren (rückwärts)" Command="{Binding ReverseCommand}" />
                <MenuItem Header="_Stummschalten" Command="{Binding MuteCommand}" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="_Vergrößern" Click="OnZoomInClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="V_erkleinern" Click="OnZoomOutClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="_Ganze Datei" Click="OnZoomFitClick" />
                <MenuItem Header="_Auswahl einpassen" Click="OnZoomSelectionClick" />
                <Separator />
                <MenuItem Header="_Live-Effekte anzeigen (EQ &amp; Hall)" IsCheckable="True"
                          IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}" InputGestureText="Strg+Umschalt+E" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Öffnen (Strg+O)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" ToolTip="Exportieren als WAV oder MP3 (Strg+E)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                </Button>
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SkipBackCommand}" ToolTip="5 Sekunden zurück (Strg+←)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9E;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PlayCommand}" ToolTip="Abspielen (Leertaste) – spielt die Auswahl oder ab dem Cursor">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="Pause (Leertaste)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding StopCommand}" ToolTip="Stopp (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SkipForwardCommand}" ToolTip="5 Sekunden vor (Strg+→)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9D;" />
                </Button>
            </ToolBar>
            <ToolBar IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                     ToolTip="Kanal-Werkzeuge (nur für Stereo-Dateien)">
                <TextBlock Margin="2,0,4,0" VerticalAlignment="Center" Text="Bearbeiten:" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="L" Foreground="#0277BD"
                              IsChecked="{Binding EditLeft, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den linken Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="R" Foreground="#C2185B"
                              IsChecked="{Binding EditRight, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den rechten Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <Separator />
                <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" Text="Hören:" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="L" Foreground="#0277BD"
                              IsChecked="{Binding HearLeft, Mode=TwoWay}"
                              ToolTip="Linken Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="R" Foreground="#C2185B"
                              IsChecked="{Binding HearRight, Mode=TwoWay}"
                              ToolTip="Rechten Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="Rückgängig (Strg+Z)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="Wiederholen (Strg+Y)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                </Button>
                <Separator />
                <Button Style="{StaticResource ToolButton}" Command="{Binding CutCommand}" ToolTip="Ausschneiden (Strg+X)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CopyCommand}" ToolTip="Kopieren (Strg+C)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PasteCommand}" ToolTip="Einfügen (Strg+V)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="Löschen (Entf)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding TrimCommand}" ToolTip="Auf Auswahl zuschneiden (Strg+T)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                </Button>
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ChangeGainCommand}" ToolTip="Lautstärke ändern …">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NormalizeCommand}" Content="Normalisieren" ToolTip="Auf -1 dB normalisieren" />
                <ToggleButton Focusable="False" Padding="7,4" Content="EQ &amp; Hall"
                              Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                              IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}"
                              ToolTip="Live-Effekte (Equalizer und Hall) ein-/ausblenden (Strg+Umschalt+E)" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding TempoPitchCommand}" Content="Tempo/Tonhöhe" ToolTip="Tempo und Tonhöhe unabhängig voneinander ändern" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding FadeInCommand}" Content="Fade In" ToolTip="Auswahl einblenden" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding FadeOutCommand}" Content="Fade Out" ToolTip="Auswahl ausblenden" />
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Click="OnZoomInClick" ToolTip="Vergrößern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnZoomOutClick" ToolTip="Verkleinern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnZoomFitClick" ToolTip="Ganze Datei anzeigen">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding FormatText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ChannelTargetText}" Margin="8,0" Foreground="#C2185B" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding EqualizerIndicator}" Margin="8,0" Foreground="#0078D4" FontWeight="SemiBold"
                           ToolTip="Live-Effekte (Equalizer/Hall) verändern gerade den Klang der Wiedergabe." />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding PositionText}" Margin="8,0" FontFamily="Consolas" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding SelectionText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Live-Equalizer: wirkt sofort auf die Wiedergabe -->
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding IsEqualizerVisible, Converter={StaticResource BoolToVisibility}}"
                Background="#F7F7F9" BorderBrush="#D9D9DE" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Width="210" Margin="0,0,18,0">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Equalizer" />
                    <CheckBox Margin="0,8,0,0" Content="Equalizer eingeschaltet" IsChecked="{Binding IsEqualizerEnabled}"
                              ToolTip="Ausschalten zum direkten Vorher-/Nachher-Vergleich" />
                    <CheckBox Margin="0,6,0,0" IsChecked="{Binding IsEqualizerPerChannel}" IsEnabled="{Binding IsStereo}"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Zwei unabhängige Equalizer: links und rechts getrennt einstellen (nur bei Stereo-Dateien)">
                        <TextBlock TextWrapping="Wrap" Text="Links/rechts getrennt (Pro-Kanal-EQ)" />
                    </CheckBox>

                    <!-- Nur im Pro-Kanal-Modus: Welcher Kanal wird gerade eingestellt? -->
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesPerChannelEqualizer, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Einstellen:" />
                            <RadioButton Margin="8,0,0,0" GroupName="EqChannel" Content="L" FontWeight="Bold" Foreground="#0277BD"
                                         Style="{StaticResource {x:Type ToggleButton}}" MinWidth="30"
                                         IsChecked="{Binding EqualizerEditsLeft}" ToolTip="Regler zeigen den EQ des linken Kanals" />
                            <RadioButton Margin="4,0,0,0" GroupName="EqChannel" Content="R" FontWeight="Bold" Foreground="#C2185B"
                                         Style="{StaticResource {x:Type ToggleButton}}" MinWidth="30"
                                         IsChecked="{Binding EqualizerEditsRight}" ToolTip="Regler zeigen den EQ des rechten Kanals" />
                        </StackPanel>
                        <Button Margin="0,6,0,0" Padding="8,2" Content="Auf anderen Kanal kopieren"
                                Command="{Binding CopyEqualizerToOtherChannelCommand}"
                                ToolTip="Überträgt die angezeigte Einstellung auf den anderen Kanal" />
                    </StackPanel>

                    <TextBlock Margin="0,10,0,2" Text="Voreinstellung:" />
                    <ComboBox ItemsSource="{Binding CurrentEqualizer.Presets}" SelectedItem="{Binding CurrentEqualizer.SelectedPreset}"
                              DisplayMemberPath="Name" />
                    <Button Margin="0,8,0,0" Padding="8,2" Content="Alle Regler auf 0" Command="{Binding CurrentEqualizer.ResetCommand}" />
                    <Button Margin="0,8,0,0" Padding="8,3" FontWeight="SemiBold" Content="In Audio übernehmen"
                            Command="{Binding ApplyEqualizerCommand}"
                            ToolTip="Rechnet den Klang fest in die Auswahl (oder die ganze Datei) ein – bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Regler wieder auf 0." />
                    <CheckBox Margin="0,8,0,0" IsChecked="{Binding EqualizerPreventClipping}"
                              ToolTip="Beim Übernehmen und Exportieren den Pegel bei Bedarf auf -1 dB absenken.">
                        <TextBlock TextWrapping="Wrap" Text="Übersteuerung verhindern" />
                    </CheckBox>
                </StackPanel>

                <Grid DockPanel.Dock="Left" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Live-Spektrum: genau so breit wie die 15 Regler, jede Spalte über ihrem Regler -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,0,0" HorizontalAlignment="Center"
                               FontSize="11" Foreground="Gray" Text="Live" />
                    <controls:SpectrumView Grid.Row="0" Grid.Column="2" Width="600" Height="130" Margin="0,0,0,4"
                                           Spectra="{Binding Spectra}"
                                           EqualizerCurve="{Binding EqualizerCurve}"
                                           EqualizerCurveRight="{Binding EqualizerCurveRight}"
                                           ActiveCurve="{Binding ActiveEqualizerCurve}"
                                           ToolTip="Spektrum der Wiedergabe nach dem Equalizer (Stereo: blau = links, rosa = rechts) · Linien: eingestellte EQ-Kurve(n)" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" HorizontalAlignment="Center"
                               FontWeight="SemiBold" FontSize="11" Text="{Binding EqualizerTargetText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#0277BD" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="#C2185B" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Row="2" Grid.Column="0" Width="52" Style="{StaticResource EqDimWhenOff}"
                                ToolTip="Vorverstärkung vor dem Equalizer – Doppelklick setzt auf 0 dB">
                        <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding CurrentEqualizer.PreampDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                        <Slider Style="{StaticResource EqSlider}" Value="{Binding CurrentEqualizer.PreampDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                        <TextBlock Style="{StaticResource EqBandLabel}" FontWeight="SemiBold" Text="Pegel" />
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="1" Width="1" Margin="6,0" Background="#D9D9DE" />

                    <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding CurrentEqualizer.Bands}" Focusable="False"
                                  Style="{StaticResource EqDimWhenOff}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="40" ToolTip="{Binding ToolTip}">
                                    <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                                    <Slider Style="{StaticResource EqSlider}" Value="{Binding GainDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                    <TextBlock Style="{StaticResource EqBandLabel}" Text="{Binding Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Grid.Column="3" Margin="6,19,0,0" Height="150" VerticalAlignment="Top">
                        <TextBlock VerticalAlignment="Top" FontSize="10" Foreground="Gray" Text="+12 dB" />
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="Gray" Text="0 dB" />
                        <TextBlock VerticalAlignment="Bottom" FontSize="10" Foreground="Gray" Text="-12 dB" />
                    </Grid>
                </Grid>

                <!-- Hall: Drehregler wie an einem Mischpult -->
                <Border DockPanel.Dock="Left" Margin="18,0,0,0" Padding="18,0,0,0"
                        BorderBrush="#D9D9DE" BorderThickness="1,0,0,0">
                    <StackPanel Width="200">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Hall" />
                        <CheckBox Margin="0,8,0,0" Content="Hall eingeschaltet" IsChecked="{Binding IsReverbEnabled}"
                                  ToolTip="Ausschalten zum direkten Vorher-/Nachher-Vergleich" />

                        <UniformGrid Margin="0,10,0,0" Columns="2" Style="{StaticResource ReverbDimWhenOff}">
                            <StackPanel Margin="0,0,0,8" ToolTip="Hall-Stärke im linken Kanal (bei Mono: im einzigen Kanal) – ziehen, Mausrad oder Doppelklick für 0">
                                <controls:Knob Width="56" Height="56" Value="{Binding ReverbLeft}" DefaultValue="0" Accent="#0277BD" />
                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbLeft, StringFormat={}{0:0} %}" />
                                <TextBlock Style="{StaticResource KnobLabel}">
                                    <TextBlock.Text>
                                        <Binding Path="IsStereo">
                                            <Binding.Converter>
                                                <local:BoolToTextConverter TrueText="Stärke Links" FalseText="Stärke" />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Hall-Stärke im rechten Kanal (nur bei Stereo) – ziehen, Mausrad oder Doppelklick für 0">
                                <controls:Knob Width="56" Height="56" Value="{Binding ReverbRight}" DefaultValue="0" Accent="#C2185B" />
                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRight, StringFormat={}{0:0} %}" />
                                <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke Rechts" />
                            </StackPanel>
                            <StackPanel ToolTip="Raumgröße: klein = kurzer Nachhall, groß = langer Nachhall – Doppelklick für 50 %">
                                <controls:Knob Width="56" Height="56" Value="{Binding ReverbRoomSize}" DefaultValue="50" Accent="#6A1B9A" />
                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRoomSize, StringFormat={}{0:0} %}" />
                                <TextBlock Style="{StaticResource KnobLabel}" Text="Raumgröße" />
                            </StackPanel>
                            <StackPanel ToolTip="Dämpfung: wenig = heller, glänzender Hall; viel = dunkler, weicher Hall – Doppelklick für 50 %">
                                <controls:Knob Width="56" Height="56" Value="{Binding ReverbDamping}" DefaultValue="50" Accent="#EF6C00" />
                                <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbDamping, StringFormat={}{0:0} %}" />
                                <TextBlock Style="{StaticResource KnobLabel}" Text="Dämpfung" />
                            </StackPanel>
                        </UniformGrid>

                        <Button Margin="0,8,0,0" Padding="8,3" FontWeight="SemiBold" Content="Hall in Audio übernehmen"
                                Command="{Binding ApplyReverbCommand}"
                                ToolTip="Rechnet den Hall fest in die Auswahl (oder die ganze Datei – dann mit Ausklingen am Ende) ein, bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Stärke-Regler wieder auf 0." />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid>
            <controls:WaveformView x:Name="Waveform"
                                   Buffer="{Binding Buffer}"
                                   Selection="{Binding Selection}"
                                   PlayheadFrame="{Binding PlayheadFrame}"
                                   SeekCommand="{Binding SeekCommand}"
                                   ActiveChannels="{Binding ActiveChannels}"
                                   MutedChannels="{Binding MutedChannels}"
                                   FollowPlayhead="{Binding IsPlaying}" />

            <Border Background="#AA000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="260" Height="6" IsIndeterminate="True" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
