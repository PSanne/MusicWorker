                            <Button Style="{DynamicResource ToolButton}" Command="{Binding Mixer.ClearAutomationCommand}" Content="Kurve löschen"
                                    ToolTip="Die gezeigte Hüllkurve der zuletzt bearbeiteten (bzw. gewählten) Spur löschen – dann gilt wieder der Regler" />
                        </ToolBar>
                    </ToolBarTray>

