                                                                <TextBlock Style="{StaticResource StripSmall}" Text="{Binding DuckThresholdText}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,2" Text="Sends" />
                                                    <UniformGrid Columns="2">
                                                        <StackPanel ToolTip="Send auf den Hall-Bus (nach dem Fader) – Doppelklick = aus">
