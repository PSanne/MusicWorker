<Window x:Class="MusicWorker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicWorker.App.Controls"
        xmlns:local="clr-namespace:MusicWorker.App.Helpers"
        xmlns:vm="clr-namespace:MusicWorker.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1360" Height="940" MinWidth="1320" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:InstrumentNameConverter x:Key="InstrumentName" />
        <local:FractionConverter x:Key="Fraction" />

        <!-- Symbole aus der Windows-Schrift „Segoe MDL2 Assets“ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Knopf-Stile der Werkzeugleisten (ToolButton, ChannelToggle) liegen im Design (Themes/Light.xaml, Themes/Dark.xaml). -->

        <Style x:Key="ReverbDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReverbEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompressorDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompressorEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DelayDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDelayEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilterEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DistortionDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDistortionEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChorusDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChorusEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlangerDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlangerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PresetItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="CommandParameter" Value="{Binding Parameter}" />
        </Style>
        <Style x:Key="GateDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGateEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SaturationDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaturationEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhaserDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPhaserEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TremoloDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTremoloEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WidenerDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWidenerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Theme.Green}" />
            <Setter Property="ToolTip" Value="Dieser Effekt ist gerade hörbar" />
        </Style>
        <Style x:Key="KnobValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="KnobLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Equalizer-Regler -->
        <Style x:Key="EqDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEqualizerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="TickPlacement" Value="Both" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EqValueLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="EqBandLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Mischkonsole -->
        <Style x:Key="Strip" TargetType="Border">
            <Setter Property="Width" Value="100" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#2A2D35" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0,4,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StripText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#C8CCD4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="StripSmall" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#9AA0AA" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="StripTitle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StripName" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="StripFader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="140" />
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="6" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="6" />
            <Setter Property="TickPlacement" Value="BottomRight" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Fader: Lautstärke – Doppelklick setzt auf 0 dB" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="140" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#66BB6A" />
            <Setter Property="Background" Value="#15171C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip" Value="Pegel (-60 … 0 dBFS)" />
        </Style>
        <Style x:Key="StripToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveKeyCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding TrimCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ToggleEqualizerCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ToggleLoopCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RecordKeyCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteKeyCommand}" />
        <KeyBinding Key="Escape" Command="{Binding TransportStopCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding TransportSkipForwardCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding TransportSkipBackCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenManualCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Öffnen …" Command="{Binding OpenCommand}" InputGestureText="Strg+O" />
                <MenuItem Header="_Zuletzt geöffnet" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Exportieren …" Command="{Binding ExportCommand}" InputGestureText="Strg+E" />
                <MenuItem Header="_Kanäle als Mono-Dateien exportieren …" Command="{Binding ExportChannelsCommand}" />
                <Separator />
                <MenuItem Header="Automatisch _sichern (alle 2 Minuten)" IsCheckable="True" IsChecked="{Binding IsAutosaveEnabled, Mode=TwoWay}"
                          ToolTip="Sichert ungespeicherte Arbeit regelmäßig in einen eigenen Ordner. Nach einem Absturz bietet MusicWorker beim nächsten Start die Wiederherstellung an." />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExitClick" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Projekt">
                <MenuItem Header="_Neues Projekt" Command="{Binding Mixer.NewProjectCommand}" />
                <MenuItem Header="Projekt ö_ffnen …" Command="{Binding Mixer.OpenProjectCommand}" />
                <MenuItem Header="Projekt _speichern" Command="{Binding Mixer.SaveProjectCommand}" InputGestureText="Strg+S (im Mischpult)" />
                <MenuItem Header="Projekt speichern _unter …" Command="{Binding Mixer.SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="Spur aus _Datei …" Command="{Binding Mixer.AddTrackFromFileCommand}" />
                <MenuItem Header="_Editor-Datei als Spur hinzufügen" Command="{Binding AddEditorAudioAsTrackCommand}" />
                <MenuItem Header="_Gruppe hinzufügen" Command="{Binding Mixer.AddGroupCommand}" />
                <Separator />
                <MenuItem Header="_Mixdown exportieren …" Command="{Binding Mixer.ExportMixdownCommand}" />
                <MenuItem Header="_Einzelspuren (Stems) exportieren …" Command="{Binding Mixer.ExportStemsCommand}"
                          ToolTip="Jede Spur als eigene, gleich lange Datei – zum Weiterarbeiten in anderen Programmen" />
                <MenuItem Header="Mixdown im _Editor öffnen" Command="{Binding OpenMixdownInEditorCommand}" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Strg+Z" />
                <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Strg+Y" />
                <Separator />
                <MenuItem Header="_Ausschneiden" Command="{Binding CutCommand}" InputGestureText="Strg+X" />
                <MenuItem Header="_Kopieren" Command="{Binding CopyCommand}" InputGestureText="Strg+C" />
                <MenuItem Header="_Einfügen" Command="{Binding PasteCommand}" InputGestureText="Strg+V" />
                <MenuItem Header="_Löschen" Command="{Binding DeleteCommand}" InputGestureText="Entf" />
                <Separator />
                <MenuItem Header="Auf Auswahl _zuschneiden" Command="{Binding TrimCommand}" InputGestureText="Strg+T" />
                <MenuItem Header="Alles a_uswählen" Command="{Binding SelectAllCommand}" InputGestureText="Strg+A" />
                <Separator />
                <MenuItem Header="_Stille einfügen …" Command="{Binding InsertSilenceCommand}" />
                <Separator />
                <MenuItem Header="_Marker setzen" Command="{Binding AddMarkerKeyCommand}" InputGestureText="M" />
                <MenuItem Header="Zum _vorherigen Marker" Command="{Binding PreviousMarkerKeyCommand}" InputGestureText="Bild↑" />
                <MenuItem Header="Zum _nächsten Marker" Command="{Binding NextMarkerKeyCommand}" InputGestureText="Bild↓" />
                <Separator />
                <MenuItem Header="Ka_näle">
                    <MenuItem Header="Effekte auf _linken Kanal" IsCheckable="True" IsChecked="{Binding EditLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <MenuItem Header="Effekte auf _rechten Kanal" IsCheckable="True" IsChecked="{Binding EditRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <Separator />
                    <MenuItem Header="Nur linken Kanal _behalten (Mono)" Command="{Binding KeepLeftChannelCommand}" />
                    <MenuItem Header="Nur rechten Kanal b_ehalten (Mono)" Command="{Binding KeepRightChannelCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Wiedergabe">
                <MenuItem Header="_Abspielen / Pause" Command="{Binding TransportToggleCommand}" InputGestureText="Leertaste" />
                <MenuItem Header="_Stopp" Command="{Binding TransportStopCommand}" InputGestureText="Esc" />
                <MenuItem Header="5 Sekunden _vor" Command="{Binding TransportSkipForwardCommand}" InputGestureText="Strg+→" />
                <MenuItem Header="5 Sekunden _zurück" Command="{Binding TransportSkipBackCommand}" InputGestureText="Strg+←" />
                <MenuItem Header="Sch_leife (Loop)" IsCheckable="True" IsChecked="{Binding IsLooping, Mode=TwoWay}" InputGestureText="Strg+L" />
                <Separator />
                <MenuItem Header="_Aufnahme starten/beenden (Mischpult)" Command="{Binding RecordKeyCommand}" InputGestureText="Strg+R" />
                <MenuItem Header="_Metronom" IsCheckable="True" IsChecked="{Binding Mixer.IsMetronomeEnabled, Mode=TwoWay}" />
                <MenuItem Header="_Latenzausgleich für Aufnahmen …" Command="{Binding SetRecordingLatencyCommand}" />
                <Separator />
                <MenuItem Header="Wiedergabe_gerät" ItemsSource="{Binding OutputDevices}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Geräteliste _aktualisieren" Command="{Binding RefreshOutputDevicesCommand}" />
                <Separator />
                <MenuItem Header="_Linken Kanal hören" IsCheckable="True" IsChecked="{Binding HearLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                <MenuItem Header="_Rechten Kanal hören" IsCheckable="True" IsChecked="{Binding HearRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
            </MenuItem>
            <MenuItem Header="E_ffekte">
                <MenuItem Header="_Lautstärke ändern …" Command="{Binding ChangeGainCommand}" />
                <MenuItem Header="_Normalisieren (Spitze auf -1 dB)" Command="{Binding NormalizeCommand}" />
                <MenuItem Header="Auf _Lautheit normalisieren (LUFS) …" Command="{Binding NormalizeLoudnessCommand}"
                          ToolTip="Auf eine empfundene Lautheit bringen, z. B. -14 LUFS für Spotify/YouTube oder -16 LUFS für Podcasts" />
                <MenuItem Header="Lautheit _messen …" Command="{Binding MeasureLoudnessCommand}"
                          ToolTip="Zeigt Gesamtlautheit (LUFS), Lautheitsumfang und echte Spitze – der Auswahl oder der ganzen Datei" />
                <MenuItem Header="_Equalizer in Audio übernehmen" Command="{Binding ApplyEqualizerCommand}" />
                <MenuItem Header="_Kompressor in Audio übernehmen" Command="{Binding ApplyCompressorCommand}" />
                <MenuItem Header="E_cho in Audio übernehmen" Command="{Binding ApplyDelayCommand}" />
                <MenuItem Header="_Hall in Audio übernehmen" Command="{Binding ApplyReverbCommand}" />
                <MenuItem Header="_Tempo &amp; Tonhöhe …" Command="{Binding TempoPitchCommand}" />
                <Separator />
                <MenuItem Header="_Einblenden (Fade In)" Command="{Binding FadeInCommand}" />
                <MenuItem Header="_Ausblenden (Fade Out)" Command="{Binding FadeOutCommand}" />
                <Separator />
                <MenuItem Header="_Umkehren (rückwärts)" Command="{Binding ReverseCommand}" />
                <MenuItem Header="_Stummschalten" Command="{Binding MuteCommand}" />
            </MenuItem>
            <MenuItem Header="_Tonhöhe &amp; Spektrum">
                <MenuItem Header="Tonhöhe _erkennen" Command="{Binding AnalyzePitchCommand}" />
                <MenuItem Header="Tempo und Ton_art erkennen …" Command="{Binding DetectTempoAndKeyCommand}"
                          ToolTip="Erkennt BPM und Tonart (z. B. a-Moll) der Auswahl oder der ganzen Datei – die Tonart lässt sich für Autotune übernehmen" />
                <MenuItem Header="Tonhöhe _korrigieren …" Command="{Binding CorrectPitchCommand}" />
                <MenuItem Header="_Autotune …" Command="{Binding AutotuneCommand}" />
                <MenuItem Header="Tonhöhen-_Verlauf …" Command="{Binding PitchRampCommand}" />
                <MenuItem Header="_Stimmeffekte …" Command="{Binding VoiceEffectCommand}" />
                <Separator />
                <MenuItem Header="S_pektrogramm anzeigen" IsCheckable="True" IsChecked="{Binding IsSpectrogramVisible, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Stimme &amp; KI">
                <MenuItem Header="_De-Esser (Zischlaute dämpfen) …" Command="{Binding DeEsserCommand}"
                          ToolTip="Scharfe „s“- und „sch“-Laute leiser machen – für Gesang, Sprache und Podcasts" />
                <MenuItem Header="_Tonhöhe ändern – Klangfarbe erhalten …" Command="{Binding NaturalPitchCommand}"
                          ToolTip="Stimme höher oder tiefer, ohne Micky-Maus- oder Monster-Klang; die Klangfarbe lässt sich auch einzeln verändern" />
                <Separator />
                <MenuItem Header="_Gesang und Begleitung trennen (KI) …" Command="{Binding SeparateVocalsCommand}"
                          ToolTip="Stimme von der Musik trennen: nur Gesang, nur Begleitung (Karaoke) oder beides als Spuren ins Mischpult" />
            </MenuItem>
            <MenuItem Header="_Reparieren">
                <MenuItem Header="_Rauschprofil aus Auswahl lernen" Command="{Binding LearnNoiseProfileCommand}"
                          ToolTip="Zuerst eine Stelle markieren, an der nur Rauschen zu hören ist" />
                <MenuItem Header="Rauschen _entfernen …" Command="{Binding RemoveNoiseCommand}" />
                <Separator />
                <MenuItem Header="_Knackser und Knistern entfernen …" Command="{Binding DeclickCommand}"
                          ToolTip="Für Schallplatten, Kassetten und Klicks von Schnitten – wirkt auf die Auswahl oder die ganze Datei" />
                <MenuItem Header="_Störgeräusch entfernen (Husten, Klingeln …) …" Command="{Binding RepairSpectrumCommand}"
                          ToolTip="Markierte Stelle durch den Klang davor und danach ersetzen. Im Spektrogramm mit Strg+Ziehen auch nur einen Frequenzbereich markieren." />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="_Vergrößern" Click="OnZoomInClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="V_erkleinern" Click="OnZoomOutClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="_Ganze Datei" Click="OnZoomFitClick" />
                <MenuItem Header="_Auswahl einpassen" Click="OnZoomSelectionClick" />
                <Separator />
                <MenuItem Header="_Design">
                    <MenuItem Header="_Hell" IsChecked="{Binding IsLightTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="_Dunkel" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    <MenuItem Header="_Wie Windows" IsChecked="{Binding IsSystemTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="System"
                              ToolTip="Folgt der Einstellung „App-Modus“ unter Windows-Einstellungen → Personalisierung → Farben" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Live-Effekte anzeigen (EQ, Hall, Kompressor, Gate …)" IsCheckable="True"
                          IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}" InputGestureText="Strg+Umschalt+E" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Handbuch (PDF)" Command="{Binding OpenManualCommand}" InputGestureText="F1" />
                <MenuItem Header="_Tastenkürzel …" Click="OnShortcutsClick" />
                <Separator />
                <MenuItem Header="Nach _Updates suchen" Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="Beim Start nach Updates _suchen" IsCheckable="True" IsChecked="{Binding IsUpdateCheckEnabled, Mode=TwoWay}"
                          ToolTip="Einmal am Tag wird bei GitHub nachgesehen, ob es eine neue Version gibt. Dabei werden keine persönlichen Daten gesendet." />
                <Separator />
                <MenuItem Header="MusicWorker im _Internet" Command="{Binding OpenProjectPageCommand}" />
                <MenuItem Header="Ü_ber MusicWorker …" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Öffnen (Strg+O)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding ExportCommand}" ToolTip="Exportieren als WAV, FLAC, MP3, M4A oder OGG (Strg+E)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding SkipBackCommand}" ToolTip="5 Sekunden zurück (Strg+←)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9E;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding PlayCommand}" ToolTip="Abspielen (Leertaste) – spielt die Auswahl oder ab dem Cursor">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="Pause (Leertaste)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding StopCommand}" ToolTip="Stopp (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding SkipForwardCommand}" ToolTip="5 Sekunden vor (Strg+→)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9D;" />
                </Button>
                <ToggleButton Focusable="False" Padding="7,4" Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                              IsChecked="{Binding IsLooping, Mode=TwoWay}"
                              ToolTip="Schleife (Strg+L): die Auswahl – ohne Auswahl die ganze Datei – endlos wiederholen">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                </ToggleButton>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                     ToolTip="Kanal-Werkzeuge (nur für Stereo-Dateien)">
                <TextBlock Margin="2,0,4,0" VerticalAlignment="Center" Text="Bearbeiten:" />
                <ToggleButton Style="{DynamicResource ChannelToggle}" Content="L" Foreground="{DynamicResource Theme.Blue}"
                              IsChecked="{Binding EditLeft, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den linken Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <ToggleButton Style="{DynamicResource ChannelToggle}" Content="R" Foreground="{DynamicResource Theme.Pink}"
                              IsChecked="{Binding EditRight, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den rechten Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <Separator />
                <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" Text="Hören:" />
                <ToggleButton Style="{DynamicResource ChannelToggle}" Content="L" Foreground="{DynamicResource Theme.Blue}"
                              IsChecked="{Binding HearLeft, Mode=TwoWay}"
                              ToolTip="Linken Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
                <ToggleButton Style="{DynamicResource ChannelToggle}" Content="R" Foreground="{DynamicResource Theme.Pink}"
                              IsChecked="{Binding HearRight, Mode=TwoWay}"
                              ToolTip="Rechten Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="Rückgängig (Strg+Z)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="Wiederholen (Strg+Y)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                </Button>
                <Separator />
                <Button Style="{DynamicResource ToolButton}" Command="{Binding CutCommand}" ToolTip="Ausschneiden (Strg+X)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding CopyCommand}" ToolTip="Kopieren (Strg+C)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding PasteCommand}" ToolTip="Einfügen (Strg+V)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="Löschen (Entf)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding TrimCommand}" ToolTip="Auf Auswahl zuschneiden (Strg+T)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding ChangeGainCommand}" ToolTip="Lautstärke ändern …">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Command="{Binding NormalizeCommand}" Content="Normalisieren" ToolTip="Lauteste Spitze auf -1 dB bringen" />
                <Button Style="{DynamicResource ToolButton}" Command="{Binding NormalizeLoudnessCommand}" Content="Lautheit …"
                        ToolTip="Auf Lautheit normalisieren (LUFS): z. B. -14 für Spotify/YouTube, -16 für Podcasts – richtet sich danach, wie laut wir es empfinden" />
                <ToggleButton Focusable="False" Padding="7,4" Content="Effekte"
                              Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                              IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}"
                              ToolTip="Live-Effekte (Equalizer, Kompressor, Echo, Hall) ein-/ausblenden (Strg+Umschalt+E)" />
                <Button Style="{DynamicResource ToolButton}" Command="{Binding TempoPitchCommand}" Content="Tempo/Tonhöhe" ToolTip="Tempo und Tonhöhe unabhängig voneinander ändern" />
                <Button Style="{DynamicResource ToolButton}" Command="{Binding FadeInCommand}" Content="Fade In" ToolTip="Auswahl einblenden" />
                <Button Style="{DynamicResource ToolButton}" Command="{Binding FadeOutCommand}" Content="Fade Out" ToolTip="Auswahl ausblenden" />
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{DynamicResource ToolButton}" Click="OnZoomInClick" ToolTip="Vergrößern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Click="OnZoomOutClick" ToolTip="Verkleinern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" />
                </Button>
                <Button Style="{DynamicResource ToolButton}" Click="OnZoomFitClick" ToolTip="Ganze Datei anzeigen">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{DynamicResource ToolButton}" Command="{Binding AddMarkerCommand}"
                        ToolTip="Marker an der aktuellen Position setzen (M). Fähnchen ziehen = verschieben, Doppelklick = umbenennen, Rechtsklick = Menü">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C1;" Foreground="#E6A100" />
                        <TextBlock Margin="4,0,0,0" Text="Marker" />
                    </StackPanel>
                </Button>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="Springen ▾" ItemsSource="{Binding MarkerItems}" IsEnabled="{Binding HasMarkers}"
                              ToolTip="Zu einem Marker springen (Bild↑ / Bild↓: vorheriger / nächster)" ToolTipService.ShowOnDisabled="True">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding JumpCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding Index}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>

        <!-- Hinweis auf eine neue Version -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource Theme.InfoBackground}" BorderBrush="{DynamicResource Theme.InfoBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="10,2" FontWeight="SemiBold" Content="Setup herunterladen" Command="{Binding DownloadUpdateCommand}"
                            ToolTip="Lädt das Setup der neuen Version im Browser herunter. Einfach starten – deine Projekte bleiben erhalten." />
                    <Button Margin="6,0,0,0" Padding="10,2" Content="Was ist neu?" Command="{Binding ShowReleaseNotesCommand}" />
                    <Button Margin="6,0,0,0" Padding="10,2" Content="Später" Command="{Binding DismissUpdateCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding UpdateText}" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding FormatText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding LoudnessText}" Margin="8,0"
                           FontFamily="Consolas" ToolTip="Empfundene Lautheit der letzten 3 Sekunden (LUFS). Spotify/YouTube spielen mit -14, Podcasts mit -16 LUFS." />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding ChannelTargetText}" Margin="8,0" Foreground="{DynamicResource Theme.Pink}" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding EqualizerIndicator}" Margin="8,0" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold"
                           ToolTip="Live-Effekte verändern gerade den Klang der Wiedergabe." />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding PositionText}" Margin="8,0" FontFamily="Consolas" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding SelectionText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem>
                <Grid>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Mixer.StatusText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding UsesMixerTransport, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedMainTab}" Padding="0">
            <TabItem Header="  Editor  ">
                <DockPanel>
                    <!-- Hinweis, wenn ein Clip aus dem Mischpult bearbeitet wird -->
                    <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource Theme.WarnBackground}" BorderBrush="{DynamicResource Theme.WarnBorder}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasLinkedClip, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="10,2" FontWeight="SemiBold" Content="In Spur übernehmen"
                                    Command="{Binding ApplyToLinkedClipCommand}" ToolTip="Die Bearbeitung in den Clip im Mischpult zurückschreiben" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding LinkedClipText}" />
                        </DockPanel>
                    </Border>
                    <!-- Live-Effekte: oben alle Effektfelder, darunter der Equalizer – alles gleichzeitig sichtbar -->
                    <Border DockPanel.Dock="Bottom"
                            Visibility="{Binding IsEqualizerVisible, Converter={StaticResource BoolToVisibility}}"
                            MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource Fraction}, ConverterParameter=0.7}"
                            Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.PanelBorder}" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,8">
                            <!-- Klang-Presets: alle Effekte auf einmal einstellen -->
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Klang-Preset:" />
                                <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                    <MenuItem Header="Laden oder speichern ▾" Padding="6,2" ItemsSource="{Binding PresetMenus[Klang]}"
                                              ItemContainerStyle="{StaticResource PresetItem}"
                                              ToolTip="Stellt alle Effekte auf einmal ein – z. B. „Podcast-Stimme“ – oder speichert deine aktuelle Einstellung als eigenes Klang-Preset" />
                                </Menu>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.ForegroundDim}"
                                           Text="Fertige Klänge wie „Podcast-Stimme“ laden oder die aktuelle Einstellung aller Effekte als eigenes Preset speichern (z. B. „Meine Stimme“)." />
                            </StackPanel>
                            <!-- Effekte über dem EQ: alle Felder gleich hoch, Reglerreihen auf gleicher Höhe (gemeinsame Zeilenhöhen) -->
                            <WrapPanel Grid.IsSharedSizeScope="True">
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Hall" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsReverbAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Hall]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="130">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsReverbEnabled}" ToolTip="Hall ein/aus – zum Vorher-/Nachher-Vergleich" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0" Columns="2" Style="{StaticResource ReverbDimWhenOff}">
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Hall-Stärke links (bei Mono: des einzigen Kanals) – Doppelklick für 0">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="0"
                                                                       Value="{Binding ReverbLeft}" Accent="{DynamicResource Theme.Blue}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbLeft, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}">
                                                            <TextBlock.Text>
                                                                <Binding Path="IsStereo">
                                                                    <Binding.Converter>
                                                                        <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Hall-Stärke rechts (nur bei Stereo) – Doppelklick für 0">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="0"
                                                                       Value="{Binding ReverbRight}" Accent="{DynamicResource Theme.Pink}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRight, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Raumgröße: klein = kurzer, groß = langer Nachhall – Doppelklick für 50 %">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                                       Value="{Binding ReverbRoomSize}" Accent="{DynamicResource Theme.Purple}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRoomSize, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Raum" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Dämpfung: wenig = heller, viel = dunkler Hall – Doppelklick für 50 %">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                                       Value="{Binding ReverbDamping}" Accent="{DynamicResource Theme.Orange}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbDamping, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Dämpfung" />
                                                    </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyReverbCommand}"
                                                ToolTip="Hall fest in die Auswahl (oder die ganze Datei – dann mit Ausklingen) einrechnen, bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Kompressor" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsCompressorAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Kompressor]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="256">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsCompressorEnabled}" ToolTip="Kompressor ein/aus – gleicht laute und leise Stellen aus" />
                                            <CheckBox Margin="0,3,0,0" Content="L/R gekoppelt" IsChecked="{Binding CompressorLinked}" IsEnabled="{Binding IsStereo}"
                                                      ToolTip="Gekoppelt werden beide Kanäle gemeinsam geregelt (stabiles Stereobild) – sonst jeder für sich." />
                                            <Grid Margin="0,6,0,0" ToolTip="Pegelreduktion: so stark regelt der Kompressor gerade herunter">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Blue}" Text="L" />
                                                <ProgressBar Grid.Row="0" Grid.Column="1" Height="7" Maximum="24" Foreground="{DynamicResource Theme.Orange}" Value="{Binding CompressorReductionLeft, Mode=OneWay}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas" Text="{Binding CompressorReductionLeft, StringFormat={}-{0:0.0} dB}" />
                                                <TextBlock Grid.Row="1" Margin="0,2,6,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Pink}" Text="R"
                                                           Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Height="7" Maximum="24" Foreground="{DynamicResource Theme.Orange}"
                                                             Value="{Binding CompressorReductionRight, Mode=OneWay}" Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,2,0,0" FontSize="10" FontFamily="Consolas"
                                                           Text="{Binding CompressorReductionRight, StringFormat={}-{0:0.0} dB}" Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0" Columns="4" Style="{StaticResource CompressorDimWhenOff}">
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Ab diesem Pegel wird leiser geregelt – Doppelklick für -18 dB">
                                                        <controls:Knob Width="42" Height="42" Minimum="-60" Maximum="0" DefaultValue="-18"
                                                                       Value="{Binding CompressorThreshold}" Accent="{DynamicResource Theme.Green}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorThreshold, StringFormat={}{0:0} dB}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Schwelle" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="4:1 = 4 dB über der Schwelle werden zu 1 dB – Doppelklick für 4:1">
                                                        <controls:Knob Width="42" Height="42" Minimum="1" Maximum="20" DefaultValue="4"
                                                                       Value="{Binding CompressorRatio}" Accent="{DynamicResource Theme.Purple}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorRatio, StringFormat={}{0:0.#}:1}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Verhältnis" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell die Regelung einsetzt – Doppelklick für 10 ms">
                                                        <controls:Knob Width="42" Height="42" Minimum="1" Maximum="100" DefaultValue="10"
                                                                       Value="{Binding CompressorAttack}" Accent="{DynamicResource Theme.Orange}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorAttack, StringFormat={}{0:0.#} ms}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Attack" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell die Regelung loslässt – Doppelklick für 150 ms">
                                                        <controls:Knob Width="42" Height="42" Minimum="20" Maximum="1000" DefaultValue="150"
                                                                       Value="{Binding CompressorRelease}" Accent="{DynamicResource Theme.Orange}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorRelease, StringFormat={}{0:0} ms}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Release" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Aufholverstärkung nach der Kompression – Doppelklick für 0 dB">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="24" DefaultValue="0"
                                                                       Value="{Binding CompressorMakeup}" Accent="{DynamicResource Theme.Teal}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMakeup, StringFormat={}+{0:0.#} dB}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Aufholen" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" ToolTip="Stärke links (100 % = voll komprimiert, 0 % = unverändert)">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                                       Value="{Binding CompressorMixLeft}" Accent="{DynamicResource Theme.Blue}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMixLeft, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}">
                                                            <TextBlock.Text>
                                                                <Binding Path="IsStereo">
                                                                    <Binding.Converter>
                                                                        <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Stärke rechts (nur bei Stereo)">
                                                        <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                                       Value="{Binding CompressorMixRight}" Accent="{DynamicResource Theme.Pink}" />
                                                        <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMixRight, StringFormat={}{0:0} %}" />
                                                        <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                                    </StackPanel>
                                        </UniformGrid>
                                        <Button Grid.Row="2" VerticalAlignment="Bottom" Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyCompressorCommand}"
                                                ToolTip="Kompressor fest in die Auswahl (oder die ganze Datei) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Margin="0,0,8,8" Padding="6,4" VerticalAlignment="Top">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="Echo" />
                                            <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsDelayAudible, Converter={StaticResource BoolToVisibility}}" />
                                            <Menu Margin="6,0,0,0" Background="Transparent" VerticalAlignment="Center">
                                                <MenuItem Header="Presets ▾" Padding="4,0" FontSize="11" ItemsSource="{Binding PresetMenus[Echo]}"
                                                          ItemContainerStyle="{StaticResource PresetItem}"
                                                          ToolTip="Fertige Einstellungen laden – oder die aktuelle als eigenes Preset speichern" />
                                            </Menu>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <Grid Width="192">
                                        <Grid.RowDefinitions>
                                            <RowDefinition SharedSizeGroup="FxOptions" />
                                            <RowDefinition SharedSizeGroup="FxKnobs" />
                                            <RowDefinition SharedSizeGroup="FxApply" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <CheckBox Content="Ein" IsChecked="{Binding IsDelayEnabled}" ToolTip="Echo ein/aus – zum Vorher-/Nachher-Vergleich" />
                                            <CheckBox Margin="0,3,0,0" Content="Ping-Pong (L ↔ R)" IsChecked="{Binding DelayPingPong}" IsEnabled="{Binding IsStereo}"
                                                      ToolTip="Die Wiederholungen wechseln zwischen linkem und rechtem Kanal (nur bei Stereo)." />
                                        </StackPanel>
