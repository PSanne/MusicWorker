<Window x:Class="MusicWorker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicWorker.App.Controls"
        xmlns:local="clr-namespace:MusicWorker.App.Helpers"
        xmlns:vm="clr-namespace:MusicWorker.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1360" Height="940" MinWidth="1320" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Symbole aus der Windows-Schrift „Segoe MDL2 Assets“ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ChannelToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ReverbDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReverbEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompressorDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompressorEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DelayDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDelayEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilterEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DistortionDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDistortionEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChorusDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChorusEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlangerDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlangerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#2E7D32" />
            <Setter Property="ToolTip" Value="Dieser Effekt ist gerade hörbar" />
        </Style>
        <Style x:Key="KnobValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="KnobLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Equalizer-Regler -->
        <Style x:Key="EqDimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEqualizerEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="TickPlacement" Value="Both" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EqValueLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="EqBandLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Mischkonsole -->
        <Style x:Key="Strip" TargetType="Border">
            <Setter Property="Width" Value="100" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#2A2D35" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0,4,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StripText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#C8CCD4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="StripSmall" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#9AA0AA" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="StripTitle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StripName" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="StripFader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="140" />
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="6" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="6" />
            <Setter Property="TickPlacement" Value="BottomRight" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Fader: Lautstärke – Doppelklick setzt auf 0 dB" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="140" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="#66BB6A" />
            <Setter Property="Background" Value="#15171C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip" Value="Pegel (-60 … 0 dBFS)" />
        </Style>
        <Style x:Key="StripToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveKeyCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding TrimCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding ToggleEqualizerCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ToggleLoopCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteKeyCommand}" />
        <KeyBinding Key="Escape" Command="{Binding TransportStopCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding TransportSkipForwardCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding TransportSkipBackCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Öffnen …" Command="{Binding OpenCommand}" InputGestureText="Strg+O" />
                <MenuItem Header="_Zuletzt geöffnet" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Exportieren …" Command="{Binding ExportCommand}" InputGestureText="Strg+E" />
                <MenuItem Header="_Kanäle als Mono-Dateien exportieren …" Command="{Binding ExportChannelsCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExitClick" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Projekt">
                <MenuItem Header="_Neues Projekt" Command="{Binding Mixer.NewProjectCommand}" />
                <MenuItem Header="Projekt ö_ffnen …" Command="{Binding Mixer.OpenProjectCommand}" />
                <MenuItem Header="Projekt _speichern" Command="{Binding Mixer.SaveProjectCommand}" InputGestureText="Strg+S (im Mischpult)" />
                <MenuItem Header="Projekt speichern _unter …" Command="{Binding Mixer.SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="Spur aus _Datei …" Command="{Binding Mixer.AddTrackFromFileCommand}" />
                <MenuItem Header="_Editor-Datei als Spur hinzufügen" Command="{Binding AddEditorAudioAsTrackCommand}" />
                <MenuItem Header="_Gruppe hinzufügen" Command="{Binding Mixer.AddGroupCommand}" />
                <Separator />
                <MenuItem Header="_Mixdown exportieren …" Command="{Binding Mixer.ExportMixdownCommand}" />
                <MenuItem Header="Mixdown im _Editor öffnen" Command="{Binding OpenMixdownInEditorCommand}" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Strg+Z" />
                <MenuItem Header="{Binding RedoText}" Command="{Binding RedoCommand}" InputGestureText="Strg+Y" />
                <Separator />
                <MenuItem Header="_Ausschneiden" Command="{Binding CutCommand}" InputGestureText="Strg+X" />
                <MenuItem Header="_Kopieren" Command="{Binding CopyCommand}" InputGestureText="Strg+C" />
                <MenuItem Header="_Einfügen" Command="{Binding PasteCommand}" InputGestureText="Strg+V" />
                <MenuItem Header="_Löschen" Command="{Binding DeleteCommand}" InputGestureText="Entf" />
                <Separator />
                <MenuItem Header="Auf Auswahl _zuschneiden" Command="{Binding TrimCommand}" InputGestureText="Strg+T" />
                <MenuItem Header="Alles a_uswählen" Command="{Binding SelectAllCommand}" InputGestureText="Strg+A" />
                <Separator />
                <MenuItem Header="_Stille einfügen …" Command="{Binding InsertSilenceCommand}" />
                <Separator />
                <MenuItem Header="Ka_näle">
                    <MenuItem Header="Effekte auf _linken Kanal" IsCheckable="True" IsChecked="{Binding EditLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <MenuItem Header="Effekte auf _rechten Kanal" IsCheckable="True" IsChecked="{Binding EditRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                    <Separator />
                    <MenuItem Header="Nur linken Kanal _behalten (Mono)" Command="{Binding KeepLeftChannelCommand}" />
                    <MenuItem Header="Nur rechten Kanal b_ehalten (Mono)" Command="{Binding KeepRightChannelCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Wiedergabe">
                <MenuItem Header="_Abspielen / Pause" Command="{Binding TransportToggleCommand}" InputGestureText="Leertaste" />
                <MenuItem Header="_Stopp" Command="{Binding TransportStopCommand}" InputGestureText="Esc" />
                <MenuItem Header="5 Sekunden _vor" Command="{Binding TransportSkipForwardCommand}" InputGestureText="Strg+→" />
                <MenuItem Header="5 Sekunden _zurück" Command="{Binding TransportSkipBackCommand}" InputGestureText="Strg+←" />
                <MenuItem Header="Sch_leife (Loop)" IsCheckable="True" IsChecked="{Binding IsLooping, Mode=TwoWay}" InputGestureText="Strg+L" />
                <Separator />
                <MenuItem Header="Wiedergabe_gerät" ItemsSource="{Binding OutputDevices}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Geräteliste _aktualisieren" Command="{Binding RefreshOutputDevicesCommand}" />
                <Separator />
                <MenuItem Header="_Linken Kanal hören" IsCheckable="True" IsChecked="{Binding HearLeft, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
                <MenuItem Header="_Rechten Kanal hören" IsCheckable="True" IsChecked="{Binding HearRight, Mode=TwoWay}" IsEnabled="{Binding IsStereo}" />
            </MenuItem>
            <MenuItem Header="E_ffekte">
                <MenuItem Header="_Lautstärke ändern …" Command="{Binding ChangeGainCommand}" />
                <MenuItem Header="_Normalisieren" Command="{Binding NormalizeCommand}" />
                <MenuItem Header="_Equalizer in Audio übernehmen" Command="{Binding ApplyEqualizerCommand}" />
                <MenuItem Header="_Kompressor in Audio übernehmen" Command="{Binding ApplyCompressorCommand}" />
                <MenuItem Header="E_cho in Audio übernehmen" Command="{Binding ApplyDelayCommand}" />
                <MenuItem Header="_Hall in Audio übernehmen" Command="{Binding ApplyReverbCommand}" />
                <MenuItem Header="_Tempo &amp; Tonhöhe …" Command="{Binding TempoPitchCommand}" />
                <Separator />
                <MenuItem Header="_Einblenden (Fade In)" Command="{Binding FadeInCommand}" />
                <MenuItem Header="_Ausblenden (Fade Out)" Command="{Binding FadeOutCommand}" />
                <Separator />
                <MenuItem Header="_Umkehren (rückwärts)" Command="{Binding ReverseCommand}" />
                <MenuItem Header="_Stummschalten" Command="{Binding MuteCommand}" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="_Vergrößern" Click="OnZoomInClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="V_erkleinern" Click="OnZoomOutClick" InputGestureText="Strg+Mausrad" />
                <MenuItem Header="_Ganze Datei" Click="OnZoomFitClick" />
                <MenuItem Header="_Auswahl einpassen" Click="OnZoomSelectionClick" />
                <Separator />
                <MenuItem Header="_Live-Effekte anzeigen (EQ, Kompressor, Echo, Hall)" IsCheckable="True"
                          IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}" InputGestureText="Strg+Umschalt+E" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Öffnen (Strg+O)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" ToolTip="Exportieren als WAV oder MP3 (Strg+E)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource ToolButton}" Command="{Binding SkipBackCommand}" ToolTip="5 Sekunden zurück (Strg+←)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9E;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PlayCommand}" ToolTip="Abspielen (Leertaste) – spielt die Auswahl oder ab dem Cursor">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="Pause (Leertaste)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding StopCommand}" ToolTip="Stopp (Esc)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SkipForwardCommand}" ToolTip="5 Sekunden vor (Strg+→)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9D;" />
                </Button>
                <ToggleButton Focusable="False" Padding="7,4" Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                              IsChecked="{Binding IsLooping, Mode=TwoWay}"
                              ToolTip="Schleife (Strg+L): die Auswahl – ohne Auswahl die ganze Datei – endlos wiederholen">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                </ToggleButton>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                     ToolTip="Kanal-Werkzeuge (nur für Stereo-Dateien)">
                <TextBlock Margin="2,0,4,0" VerticalAlignment="Center" Text="Bearbeiten:" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="L" Foreground="#0277BD"
                              IsChecked="{Binding EditLeft, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den linken Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="R" Foreground="#C2185B"
                              IsChecked="{Binding EditRight, Mode=TwoWay}"
                              ToolTip="Effekte wirken auf den rechten Kanal. (Schneiden und Einfügen betreffen immer beide Kanäle.)" />
                <Separator />
                <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" Text="Hören:" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="L" Foreground="#0277BD"
                              IsChecked="{Binding HearLeft, Mode=TwoWay}"
                              ToolTip="Linken Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
                <ToggleButton Style="{StaticResource ChannelToggle}" Content="R" Foreground="#C2185B"
                              IsChecked="{Binding HearRight, Mode=TwoWay}"
                              ToolTip="Rechten Kanal abhören (aus = beim Abspielen stumm; die Datei bleibt unverändert)" />
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="Rückgängig (Strg+Z)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="Wiederholen (Strg+Y)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                </Button>
                <Separator />
                <Button Style="{StaticResource ToolButton}" Command="{Binding CutCommand}" ToolTip="Ausschneiden (Strg+X)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CopyCommand}" ToolTip="Kopieren (Strg+C)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PasteCommand}" ToolTip="Einfügen (Strg+V)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" ToolTip="Löschen (Entf)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding TrimCommand}" ToolTip="Auf Auswahl zuschneiden (Strg+T)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A8;" />
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource ToolButton}" Command="{Binding ChangeGainCommand}" ToolTip="Lautstärke ändern …">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NormalizeCommand}" Content="Normalisieren" ToolTip="Auf -1 dB normalisieren" />
                <ToggleButton Focusable="False" Padding="7,4" Content="Effekte"
                              Style="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                              IsChecked="{Binding IsEqualizerVisible, Mode=TwoWay}"
                              ToolTip="Live-Effekte (Equalizer, Kompressor, Echo, Hall) ein-/ausblenden (Strg+Umschalt+E)" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding TempoPitchCommand}" Content="Tempo/Tonhöhe" ToolTip="Tempo und Tonhöhe unabhängig voneinander ändern" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding FadeInCommand}" Content="Fade In" ToolTip="Auswahl einblenden" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding FadeOutCommand}" Content="Fade Out" ToolTip="Auswahl ausblenden" />
            </ToolBar>
            <ToolBar Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource ToolButton}" Click="OnZoomInClick" ToolTip="Vergrößern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnZoomOutClick" ToolTip="Verkleinern (Strg+Mausrad)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnZoomFitClick" ToolTip="Ganze Datei anzeigen">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding FormatText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding ChannelTargetText}" Margin="8,0" Foreground="#C2185B" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding EqualizerIndicator}" Margin="8,0" Foreground="#0078D4" FontWeight="SemiBold"
                           ToolTip="Live-Effekte verändern gerade den Klang der Wiedergabe." />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding PositionText}" Margin="8,0" FontFamily="Consolas" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" Text="{Binding SelectionText}" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem>
                <Grid>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsEditorTab, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Mixer.StatusText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsMixerTab, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedMainTab}" Padding="0">
            <TabItem Header="  Editor  ">
                <DockPanel>
                    <!-- Hinweis, wenn ein Clip aus dem Mischpult bearbeitet wird -->
                    <Border DockPanel.Dock="Top" Padding="10,6" Background="#FFF4E5" BorderBrush="#FFB74D" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasLinkedClip, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="10,2" FontWeight="SemiBold" Content="In Spur übernehmen"
                                    Command="{Binding ApplyToLinkedClipCommand}" ToolTip="Die Bearbeitung in den Clip im Mischpult zurückschreiben" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding LinkedClipText}" />
                        </DockPanel>
                    </Border>
                    <!-- Live-Effekte: Equalizer, Hall, Kompressor und Echo – alle gleichzeitig sichtbar -->
                    <Border DockPanel.Dock="Bottom"
                            Visibility="{Binding IsEqualizerVisible, Converter={StaticResource BoolToVisibility}}"
                            Background="#F7F7F9" BorderBrush="#D9D9DE" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,8" Orientation="Horizontal">
                            <!-- Equalizer -->
                            <StackPanel Width="615">
                                <WrapPanel>
                                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Equalizer" />
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Ein" IsChecked="{Binding IsEqualizerEnabled}"
                                              ToolTip="Equalizer ein/aus – zum direkten Vorher-/Nachher-Vergleich" />
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="L/R getrennt" IsChecked="{Binding IsEqualizerPerChannel}"
                                              IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Pro-Kanal-EQ: links und rechts getrennt einstellen (nur bei Stereo)" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UsesPerChannelEqualizer, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock VerticalAlignment="Center" Text="Einstellen:" />
                                        <RadioButton Margin="6,0,0,0" GroupName="EqChannel" Content="L" FontWeight="Bold" Foreground="#0277BD"
                                                     Style="{StaticResource {x:Type ToggleButton}}" MinWidth="28"
                                                     IsChecked="{Binding EqualizerEditsLeft}" ToolTip="Regler zeigen den EQ des linken Kanals" />
                                        <RadioButton Margin="3,0,0,0" GroupName="EqChannel" Content="R" FontWeight="Bold" Foreground="#C2185B"
                                                     Style="{StaticResource {x:Type ToggleButton}}" MinWidth="28"
                                                     IsChecked="{Binding EqualizerEditsRight}" ToolTip="Regler zeigen den EQ des rechten Kanals" />
                                        <Button Margin="6,0,0,0" Padding="6,1" Content="Auf anderen Kanal kopieren"
                                                Command="{Binding CopyEqualizerToOtherChannelCommand}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,6">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Voreinstellung:" />
                                    <ComboBox Width="140" Margin="0,0,8,0" ItemsSource="{Binding CurrentEqualizer.Presets}"
                                              SelectedItem="{Binding CurrentEqualizer.SelectedPreset}" DisplayMemberPath="Name" />
                                    <Button Margin="0,0,8,0" Padding="6,1" Content="Alle auf 0" Command="{Binding CurrentEqualizer.ResetCommand}" />
                                    <Button Margin="0,0,8,0" Padding="6,1" FontWeight="SemiBold" Content="In Audio übernehmen"
                                            Command="{Binding ApplyEqualizerCommand}"
                                            ToolTip="Klang fest in die Auswahl (oder die ganze Datei) einrechnen – bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Regler auf 0." />
                                    <CheckBox VerticalAlignment="Center" Content="Übersteuerung verhindern" IsChecked="{Binding EqualizerPreventClipping}"
                                              ToolTip="Gilt für alle Effekte: beim Übernehmen und Exportieren den Pegel bei Bedarf auf -1 dB absenken." />
                                </WrapPanel>

                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Text="Live" />
                                    <controls:SpectrumView Grid.Row="0" Grid.Column="2" Width="510" Height="120" Margin="0,0,0,4"
                                                           Spectra="{Binding Spectra}"
                                                           EqualizerCurve="{Binding EqualizerCurve}"
                                                           EqualizerCurveRight="{Binding EqualizerCurveRight}"
                                                           ActiveCurve="{Binding ActiveEqualizerCurve}"
                                                           ToolTip="Spektrum der Wiedergabe nach allen Effekten (Stereo: blau = links, rosa = rechts) · Linien: EQ-Kurve(n)" />

                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,0,2" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11"
                                               Text="{Binding EqualizerTargetText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="#0277BD" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UsesPerChannelEqualizer}" Value="True" />
                                                            <Condition Binding="{Binding EqualizerEditsRight}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="#C2185B" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Width="52" Style="{StaticResource EqDimWhenOff}"
                                                ToolTip="Vorverstärkung vor dem Equalizer – Doppelklick setzt auf 0 dB">
                                        <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding CurrentEqualizer.PreampDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                                        <Slider Style="{StaticResource EqSlider}" Value="{Binding CurrentEqualizer.PreampDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                        <TextBlock Style="{StaticResource EqBandLabel}" FontWeight="SemiBold" Text="Pegel" />
                                    </StackPanel>

                                    <Border Grid.Row="2" Grid.Column="1" Width="1" Margin="6,0" Background="#D9D9DE" />

                                    <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding CurrentEqualizer.Bands}" Focusable="False"
                                                  Style="{StaticResource EqDimWhenOff}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="34" ToolTip="{Binding ToolTip}">
                                                    <TextBlock Style="{StaticResource EqValueLabel}" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                                                    <Slider Style="{StaticResource EqSlider}" Value="{Binding GainDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                                    <TextBlock Style="{StaticResource EqBandLabel}" Text="{Binding Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Row="2" Grid.Column="3" Margin="5,18,0,0" Height="150" VerticalAlignment="Top">
                                        <TextBlock VerticalAlignment="Top" FontSize="10" Foreground="Gray" Text="+12" />
                                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="Gray" Text="0 dB" />
                                        <TextBlock VerticalAlignment="Bottom" FontSize="10" Foreground="Gray" Text="-12" />
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <!-- Weitere Effekte: Filter, Verzerrung, Kompressor, Chorus, Flanger, Echo, Hall -->
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Hall" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsReverbAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="130">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsReverbEnabled}" ToolTip="Hall ein/aus – zum Vorher-/Nachher-Vergleich" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2" Style="{StaticResource ReverbDimWhenOff}">
                                                <StackPanel Margin="0,0,0,6" ToolTip="Hall-Stärke links (bei Mono: des einzigen Kanals) – Doppelklick für 0">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="0"
                                                                   Value="{Binding ReverbLeft}" Accent="#0277BD" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbLeft, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}">
                                                        <TextBlock.Text>
                                                            <Binding Path="IsStereo">
                                                                <Binding.Converter>
                                                                    <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Hall-Stärke rechts (nur bei Stereo) – Doppelklick für 0">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="0"
                                                                   Value="{Binding ReverbRight}" Accent="#C2185B" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRight, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Raumgröße: klein = kurzer, groß = langer Nachhall – Doppelklick für 50 %">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                                   Value="{Binding ReverbRoomSize}" Accent="#6A1B9A" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbRoomSize, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Raum" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Dämpfung: wenig = heller, viel = dunkler Hall – Doppelklick für 50 %">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                                   Value="{Binding ReverbDamping}" Accent="#EF6C00" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ReverbDamping, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Dämpfung" />
                                                </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyReverbCommand}"
                                            ToolTip="Hall fest in die Auswahl (oder die ganze Datei – dann mit Ausklingen) einrechnen, bei Stereo in die unter „Bearbeiten L/R“ gewählten Kanäle. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Kompressor" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsCompressorAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="256">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsCompressorEnabled}" ToolTip="Kompressor ein/aus – gleicht laute und leise Stellen aus" />
                                    <CheckBox Margin="0,3,0,0" Content="L/R gekoppelt" IsChecked="{Binding CompressorLinked}" IsEnabled="{Binding IsStereo}"
                                              ToolTip="Gekoppelt werden beide Kanäle gemeinsam geregelt (stabiles Stereobild) – sonst jeder für sich." />
                                    <Grid Margin="0,6,0,0" ToolTip="Pegelreduktion: so stark regelt der Kompressor gerade herunter">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="0,0,6,0" FontSize="11" FontWeight="Bold" Foreground="#0277BD" Text="L" />
                                        <ProgressBar Grid.Row="0" Grid.Column="1" Height="7" Maximum="24" Foreground="#EF6C00" Value="{Binding CompressorReductionLeft, Mode=OneWay}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" FontSize="10" FontFamily="Consolas" Text="{Binding CompressorReductionLeft, StringFormat={}-{0:0.0} dB}" />
                                        <TextBlock Grid.Row="1" Margin="0,2,6,0" FontSize="11" FontWeight="Bold" Foreground="#C2185B" Text="R"
                                                   Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Height="7" Maximum="24" Foreground="#EF6C00"
                                                     Value="{Binding CompressorReductionRight, Mode=OneWay}" Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,2,0,0" FontSize="10" FontFamily="Consolas"
                                                   Text="{Binding CompressorReductionRight, StringFormat={}-{0:0.0} dB}" Visibility="{Binding IsStereo, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <UniformGrid Margin="0,8,0,0" Columns="4" Style="{StaticResource CompressorDimWhenOff}">
                                                <StackPanel Margin="0,0,0,6" ToolTip="Ab diesem Pegel wird leiser geregelt – Doppelklick für -18 dB">
                                                    <controls:Knob Width="42" Height="42" Minimum="-60" Maximum="0" DefaultValue="-18"
                                                                   Value="{Binding CompressorThreshold}" Accent="#2E7D32" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorThreshold, StringFormat={}{0:0} dB}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Schwelle" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="4:1 = 4 dB über der Schwelle werden zu 1 dB – Doppelklick für 4:1">
                                                    <controls:Knob Width="42" Height="42" Minimum="1" Maximum="20" DefaultValue="4"
                                                                   Value="{Binding CompressorRatio}" Accent="#6A1B9A" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorRatio, StringFormat={}{0:0.#}:1}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Verhältnis" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell die Regelung einsetzt – Doppelklick für 10 ms">
                                                    <controls:Knob Width="42" Height="42" Minimum="1" Maximum="100" DefaultValue="10"
                                                                   Value="{Binding CompressorAttack}" Accent="#EF6C00" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorAttack, StringFormat={}{0:0.#} ms}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Attack" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell die Regelung loslässt – Doppelklick für 150 ms">
                                                    <controls:Knob Width="42" Height="42" Minimum="20" Maximum="1000" DefaultValue="150"
                                                                   Value="{Binding CompressorRelease}" Accent="#EF6C00" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorRelease, StringFormat={}{0:0} ms}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Release" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Aufholverstärkung nach der Kompression – Doppelklick für 0 dB">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="24" DefaultValue="0"
                                                                   Value="{Binding CompressorMakeup}" Accent="#00838F" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMakeup, StringFormat={}+{0:0.#} dB}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Aufholen" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Stärke links (100 % = voll komprimiert, 0 % = unverändert)">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                                   Value="{Binding CompressorMixLeft}" Accent="#0277BD" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMixLeft, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}">
                                                        <TextBlock.Text>
                                                            <Binding Path="IsStereo">
                                                                <Binding.Converter>
                                                                    <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Stärke rechts (nur bei Stereo)">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                                   Value="{Binding CompressorMixRight}" Accent="#C2185B" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding CompressorMixRight, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                                </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyCompressorCommand}"
                                            ToolTip="Kompressor fest in die Auswahl (oder die ganze Datei) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Echo" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsDelayAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="192">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsDelayEnabled}" ToolTip="Echo ein/aus – zum Vorher-/Nachher-Vergleich" />
                                    <CheckBox Margin="0,3,0,0" Content="Ping-Pong (L ↔ R)" IsChecked="{Binding DelayPingPong}" IsEnabled="{Binding IsStereo}"
                                              ToolTip="Die Wiederholungen wechseln zwischen linkem und rechtem Kanal (nur bei Stereo)." />
                                    <UniformGrid Margin="0,8,0,0" Columns="3" Style="{StaticResource DelayDimWhenOff}">
                                                <StackPanel Margin="0,0,0,6" ToolTip="Verzögerung links (bei Mono: des einzigen Kanals) – Umschalt+Ziehen für feine Schritte">
                                                    <controls:Knob Width="42" Height="42" Minimum="20" Maximum="2000" DefaultValue="375"
                                                                   Value="{Binding DelayTimeLeft}" Accent="#0277BD" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayTimeLeft, StringFormat={}{0:0} ms}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}">
                                                        <TextBlock.Text>
                                                            <Binding Path="IsStereo">
                                                                <Binding.Converter>
                                                                    <local:BoolToTextConverter TrueText="Zeit L" FalseText="Zeit" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Verzögerung rechts (nur bei Stereo)">
                                                    <controls:Knob Width="42" Height="42" Minimum="20" Maximum="2000" DefaultValue="375"
                                                                   Value="{Binding DelayTimeRight}" Accent="#C2185B" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayTimeRight, StringFormat={}{0:0} ms}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Zeit R" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Rückkopplung: wie viele Wiederholungen – Doppelklick für 35 %">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="90" DefaultValue="35"
                                                                   Value="{Binding DelayFeedback}" Accent="#6A1B9A" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayFeedback, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Rückkoppl." />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Lautstärke des Echos links">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="30"
                                                                   Value="{Binding DelayMixLeft}" Accent="#0277BD" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayMixLeft, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}">
                                                        <TextBlock.Text>
                                                            <Binding Path="IsStereo">
                                                                <Binding.Converter>
                                                                    <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Lautstärke des Echos rechts (nur bei Stereo)">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="30"
                                                                   Value="{Binding DelayMixRight}" Accent="#C2185B" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayMixRight, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,6" ToolTip="Jede Wiederholung wird dumpfer, wie bei einem Bandecho – Doppelklick für 30 %">
                                                    <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="30"
                                                                   Value="{Binding DelayDamping}" Accent="#EF6C00" />
                                                    <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DelayDamping, StringFormat={}{0:0} %}" />
                                                    <TextBlock Style="{StaticResource KnobLabel}" Text="Dämpfung" />
                                                </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyDelayCommand}"
                                            ToolTip="Echo fest in die Auswahl (oder die ganze Datei – dann mit Ausklingen) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Filter" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsFilterAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="128">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsFilterEnabled}" ToolTip="Hoch-/Tiefpass ein/aus" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2" Style="{StaticResource FilterDimWhenOff}">
                                        <StackPanel Margin="0,0,0,6" ToolTip="Hochpass: schneidet tiefe Frequenzen (Brummen, Rumpeln) ab – ganz links = aus, Doppelklick = aus">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="0"
                                                           Value="{Binding FilterHighPassPosition}" Accent="#00838F" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FilterHighPassText}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Hochpass" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Tiefpass: schneidet hohe Frequenzen (Rauschen, Zischen) ab – ganz rechts = aus, Doppelklick = aus">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                           Value="{Binding FilterLowPassPosition}" Accent="#6A1B9A" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FilterLowPassText}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Tiefpass" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyFilterCommand}"
                                            ToolTip="Filter fest in die Auswahl (oder die ganze Datei) einrechnen. Danach steht der Filter wieder auf „aus“." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Verzerrung" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsDistortionAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="128">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsDistortionEnabled}" ToolTip="Verzerrung ein/aus" />
                                    <ComboBox Margin="0,4,0,0" FontSize="11" ItemsSource="{Binding DistortionTypes}" SelectedIndex="{Binding DistortionTypeIndex}"
                                              ToolTip="Charakter der Verzerrung" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2" Style="{StaticResource DistortionDimWhenOff}">
                                        <StackPanel Margin="0,0,0,6" ToolTip="Wie stark verzerrt wird – Doppelklick für 50 %">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                           Value="{Binding DistortionDrive}" Accent="#D84315" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DistortionDrive, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Drive" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Klangfarbe: wenig = dumpf, viel = hell – Doppelklick für 70 %">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding DistortionTone}" Accent="#EF6C00" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DistortionTone, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Ton" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Anteil der Verzerrung links (bei Mono: des einzigen Kanals)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                           Value="{Binding DistortionMixLeft}" Accent="#0277BD" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DistortionMixLeft, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}">
                                                <TextBlock.Text>
                                                    <Binding Path="IsStereo">
                                                        <Binding.Converter>
                                                            <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Anteil der Verzerrung rechts (nur bei Stereo)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="100"
                                                           Value="{Binding DistortionMixRight}" Accent="#C2185B" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding DistortionMixRight, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyDistortionCommand}"
                                            ToolTip="Verzerrung fest in die Auswahl (oder die ganze Datei) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Chorus" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsChorusAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="128">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsChorusEnabled}" ToolTip="Chorus ein/aus – klingt voller, wie mehrere Stimmen" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2" Style="{StaticResource ChorusDimWhenOff}">
                                        <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell die Stimmen schwanken – Doppelklick für 0,8 Hz">
                                            <controls:Knob Width="42" Height="42" Minimum="0.1" Maximum="5" DefaultValue="0.8"
                                                           Value="{Binding ChorusRate}" Accent="#2E7D32" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ChorusRate, StringFormat={}{0:0.0} Hz}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Tempo" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Wie stark die Stimmen schwanken – Doppelklick für 50 %">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="50"
                                                           Value="{Binding ChorusDepth}" Accent="#6A1B9A" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ChorusDepth, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Tiefe" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Chorus-Anteil links (bei Mono: des einzigen Kanals)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding ChorusMixLeft}" Accent="#0277BD" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ChorusMixLeft, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}">
                                                <TextBlock.Text>
                                                    <Binding Path="IsStereo">
                                                        <Binding.Converter>
                                                            <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Chorus-Anteil rechts (nur bei Stereo)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding ChorusMixRight}" Accent="#C2185B" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding ChorusMixRight, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyChorusCommand}"
                                            ToolTip="Chorus fest in die Auswahl (oder die ganze Datei) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Margin="8,0,0,0" Padding="6,4" VerticalAlignment="Top">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="Flanger" />
                                        <Ellipse Style="{StaticResource ActiveDot}" Visibility="{Binding IsFlangerAudible, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Width="192">
                                    <CheckBox Content="Ein" IsChecked="{Binding IsFlangerEnabled}" ToolTip="Flanger ein/aus – der typische „Düsenjet“-Klang" />
                                    <UniformGrid Margin="0,8,0,0" Columns="3" Style="{StaticResource FlangerDimWhenOff}">
                                        <StackPanel Margin="0,0,0,6" ToolTip="Wie schnell der Effekt wandert – Doppelklick für 0,3 Hz">
                                            <controls:Knob Width="42" Height="42" Minimum="0.1" Maximum="2" DefaultValue="0.3"
                                                           Value="{Binding FlangerRate}" Accent="#2E7D32" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FlangerRate, StringFormat={}{0:0.0} Hz}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Tempo" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Wie weit der Effekt wandert – Doppelklick für 70 %">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding FlangerDepth}" Accent="#6A1B9A" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FlangerDepth, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Tiefe" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Rückkopplung: macht den Klang schärfer, „metallischer“ – Doppelklick für 50 %">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="90" DefaultValue="50"
                                                           Value="{Binding FlangerFeedback}" Accent="#EF6C00" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FlangerFeedback, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Rückk." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" ToolTip="Flanger-Anteil links (bei Mono: des einzigen Kanals)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding FlangerMixLeft}" Accent="#0277BD" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FlangerMixLeft, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}">
                                                <TextBlock.Text>
                                                    <Binding Path="IsStereo">
                                                        <Binding.Converter>
                                                            <local:BoolToTextConverter TrueText="Stärke L" FalseText="Stärke" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IsStereo}" ToolTipService.ShowOnDisabled="True" ToolTip="Flanger-Anteil rechts (nur bei Stereo)">
                                            <controls:Knob Width="42" Height="42" Minimum="0" Maximum="100" DefaultValue="70"
                                                           Value="{Binding FlangerMixRight}" Accent="#C2185B" />
                                            <TextBlock Style="{StaticResource KnobValue}" Text="{Binding FlangerMixRight, StringFormat={}{0:0} %}" />
                                            <TextBlock Style="{StaticResource KnobLabel}" Text="Stärke R" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Button Padding="6,2" FontWeight="SemiBold" Content="Übernehmen" Command="{Binding ApplyFlangerCommand}"
                                            ToolTip="Flanger fest in die Auswahl (oder die ganze Datei) einrechnen. Danach stehen die übernommenen Stärke-Regler auf 0." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid>
                        <controls:WaveformView x:Name="Waveform"
                                               Buffer="{Binding Buffer}"
                                               Selection="{Binding Selection}"
                                               PlayheadFrame="{Binding PlayheadFrame}"
                                               SeekCommand="{Binding SeekCommand}"
                                               ActiveChannels="{Binding ActiveChannels}"
                                               MutedChannels="{Binding MutedChannels}"
                                               FollowPlayhead="{Binding IsPlaying}" />

                        <Border Background="#AA000000"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="260" Height="6" IsIndeterminate="True" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Mischpult  ">
                <DockPanel>
                    <!-- Mischpult-Werkzeugleiste -->
                    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding TransportSkipBackCommand}" ToolTip="5 Sekunden zurück (Strg+←)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9E;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.PlayCommand}" ToolTip="Projekt abspielen (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.PauseCommand}" ToolTip="Pause (Leertaste)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.StopCommand}" ToolTip="Stopp (Esc) – zurück zur Startposition">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding TransportSkipForwardCommand}" ToolTip="5 Sekunden vor (Strg+→)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9D;" />
                            </Button>
                            <TextBlock Margin="8,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding Mixer.PositionText}" />
                        </ToolBar>
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.NewProjectCommand}" Content="Neu" ToolTip="Neues, leeres Projekt" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.OpenProjectCommand}" ToolTip="Projekt öffnen …">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.SaveProjectCommand}" ToolTip="Projekt speichern (Strg+S)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.SaveProjectAsCommand}" Content="Speichern unter …" />
                        </ToolBar>
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.AddTrackFromFileCommand}" Content="+ Spur aus Datei …"
                                    ToolTip="Audiodatei als neue Spur laden (auch per Drag &amp; Drop möglich)" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding AddEditorAudioAsTrackCommand}" Content="+ Editor-Datei"
                                    ToolTip="Das Audio aus dem Editor (inkl. Bearbeitungen) als neue Spur übernehmen" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.OpenSelectedClipInEditorCommand}" Content="Clip im Editor"
                                    ToolTip="Gewählten Clip im Editor bearbeiten (oder Doppelklick auf den Clip)" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.DeleteSelectedClipCommand}" Content="Clip löschen"
                                    ToolTip="Gewählten Clip löschen (Entf)" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.AddGroupCommand}" Content="+ Gruppe"
                                    ToolTip="Neue Gruppe anlegen – Spuren im Kanalzug zuordnen" />
                        </ToolBar>
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.ExportMixdownCommand}" Content="Mixdown exportieren …"
                                    ToolTip="Alle Spuren zu einer Stereo-Datei (WAV/MP3) mischen" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenMixdownInEditorCommand}" Content="Mixdown im Editor"
                                    ToolTip="Den Mixdown im Editor öffnen und dort weiterbearbeiten" />
                        </ToolBar>
                        <ToolBar>
                            <Button Style="{StaticResource ToolButton}" Click="OnTimelineZoomInClick" ToolTip="Vergrößern (Strg+Mausrad)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A3;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="OnTimelineZoomOutClick" ToolTip="Verkleinern (Strg+Mausrad)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71F;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="OnTimelineZoomFitClick" ToolTip="Ganzes Projekt anzeigen">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" />
                            </Button>
                            <TextBlock Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Mixer.ProjectTitle}" />
                        </ToolBar>
                        <ToolBar Band="1">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.UndoCommand}" ToolTip="Rückgängig im Mischpult (Strg+Z)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.RedoCommand}" ToolTip="Wiederholen im Mischpult (Strg+Y)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" />
                            </Button>
                            <Separator />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.SplitClipCommand}" ToolTip="Trenner: Clip an der Abspielposition (roter Griff) teilen (Strg+T)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" />
                                    <TextBlock Margin="4,0,0,0" Text="Teilen" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.MergeWithNextClipCommand}" Content="Verbinden"
                                    ToolTip="Clip-Zusammenführung: den gewählten Clip mit dem nächsten Clip derselben Spur zu einem Clip verbinden" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.AutoTrimClipCommand}" Content="Auto-Zuschnitt"
                                    ToolTip="Stille am Anfang und Ende des gewählten Clips entfernen" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.ArrangeClipsCommand}" Content="Aneinanderreihen …"
                                    ToolTip="Alle Clips der Spur lückenlos hintereinanderlegen – auf Wunsch mit Überblendung (Mixtape)" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.BounceCommand}" Content="Zusammenmischen"
                                    ToolTip="Clip-Mischung: alle hörbaren Spuren zu einer neuen Spur mischen (Quellen werden stummgeschaltet)" />
                        </ToolBar>
                        <ToolBar Band="1">
                            <ToggleButton Style="{StaticResource ChannelToggle}" Content="Raster" IsChecked="{Binding Mixer.ShowGrid}"
                                          ToolTip="Takt-Raster in der Spuransicht anzeigen" />
                            <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="Tempo" />
                            <TextBox Width="44" VerticalAlignment="Center" HorizontalContentAlignment="Right" Text="{Binding Mixer.BpmText, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnCommitTextBoxKeyDown" ToolTip="Tempo in Schlägen pro Minute (20 … 300) – mit Eingabetaste übernehmen" />
                            <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" Text="BPM" />
                            <ComboBox Width="52" VerticalAlignment="Center" ItemsSource="{Binding Mixer.BeatsPerBarChoices}" SelectedItem="{Binding Mixer.BeatsPerBar}"
                                      ItemStringFormat="{}{0}/4" ToolTip="Taktart (Schläge pro Takt)" />
                            <ToggleButton Style="{StaticResource ChannelToggle}" Margin="6,0,0,0" Content="Einrasten" IsChecked="{Binding Mixer.IsSnapEnabled}"
                                          ToolTip="Clips und Loop-Bereich rasten beim Verschieben auf die Schläge des Rasters ein" />
                            <Separator />
                            <ToggleButton Style="{StaticResource ChannelToggle}" IsChecked="{Binding Mixer.IsLooping}"
                                          ToolTip="Loop-Bereich wiederholen (Strg+L) – Bereich mit Umschalt+Ziehen in der Spuransicht festlegen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                                    <TextBlock Margin="4,0,0,0" Text="Loop" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding Mixer.LoopSelectedClipCommand}" Content="Loop = Clip"
                                    ToolTip="Den gewählten Clip als Loop-Bereich übernehmen" />
                            <Separator />
                            <ToggleButton Style="{StaticResource ChannelToggle}" Content="Inserts" IsChecked="{Binding Mixer.ShowInserts}"
                                          ToolTip="EQ, Hochpass und Kompressor in den Kanalzügen ein-/ausblenden" />
                            <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="#80868F" FontSize="11"
                                       Text="Tipp: Clips auf andere Spuren ziehen · Umschalt+Ziehen = Loop-Bereich" />
                        </ToolBar>
                    </ToolBarTray>

                    <!-- Mischkonsole -->
                    <Border DockPanel.Dock="Bottom" Background="#1E2026" BorderBrush="#3A3E48" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Mixer.Tracks}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Strip}" BorderBrush="{Binding Color}">
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource StripName}" Text="{Binding Name}" ToolTip="Spurname (zum Ändern anklicken)" />
                                                    <controls:Knob Width="36" Height="36" Margin="0,4,0,0" Minimum="-100" Maximum="100" DefaultValue="0"
                                                                   Value="{Binding Pan}" Accent="#90CAF9"
                                                                   ToolTip="Panorama: ziehen oder Mausrad – Doppelklick = Mitte" />
                                                    <TextBlock Style="{StaticResource StripText}" Text="{Binding PanText}" />
                                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Meter, Mode=OneWay}" />
                                                        <Slider Style="{StaticResource StripFader}" Value="{Binding VolumeDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ToggleButton Style="{StaticResource StripToggle}" Content="M" IsChecked="{Binding Mute}" ToolTip="Stumm (Mute)" />
                                                        <ToggleButton Style="{StaticResource StripToggle}" Margin="4,0,0,0" Content="S" IsChecked="{Binding Solo}" ToolTip="Solo" />
                                                    </StackPanel>
                                                    <StackPanel Visibility="{Binding DataContext.Mixer.ShowInserts, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,2" Text="EQ" />
                                                        <UniformGrid Columns="3">
                                                            <StackPanel ToolTip="Tiefen ±12 dB (120 Hz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqLow}" Accent="#E57373" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Tief" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Mitten ±12 dB (1 kHz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqMid}" Accent="#FFD54F" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Mitte" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Höhen ±12 dB (8 kHz) – Doppelklick = 0">
                                                                <controls:Knob Width="24" Height="24" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding EqHigh}" Accent="#4FC3F7" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Höhe" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <UniformGrid Margin="0,4,0,0" Columns="2">
                                                            <StackPanel ToolTip="Hochpass: entfernt Brummen und Rumpeln unterhalb der Frequenz (20 Hz = aus) – Doppelklick = aus">
                                                                <controls:Knob Width="24" Height="24" Minimum="20" Maximum="500" DefaultValue="20" Value="{Binding HighPassHz}" Accent="#81C784" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="{Binding HighPassText}" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Kompressor: gleicht Lautstärkeschwankungen aus (0 % = aus) – Doppelklick = aus">
                                                                <controls:Knob Width="24" Height="24" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding Compression}" Accent="#FF8A65" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Komp." />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,2" Text="Sends" />
                                                    <UniformGrid Columns="2">
                                                        <StackPanel ToolTip="Send auf den Hall-Bus (nach dem Fader) – Doppelklick = aus">
                                                            <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding SendHall}" Accent="#BA68C8" />
                                                            <TextBlock Style="{StaticResource StripSmall}" Text="Hall" />
                                                        </StackPanel>
                                                        <StackPanel ToolTip="Send auf den Echo-Bus (nach dem Fader) – Doppelklick = aus">
                                                            <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding SendEcho}" Accent="#FFB74D" />
                                                            <TextBlock Style="{StaticResource StripSmall}" Text="Echo" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <ComboBox Margin="0,6,0,0" FontSize="11" DisplayMemberPath="Name" SelectedItem="{Binding Group}"
                                                              ItemsSource="{Binding DataContext.Mixer.GroupChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              ToolTip="Gruppe: deren Fader und Mute wirken zusätzlich auf diese Spur" />
                                                    <Button Style="{StaticResource StripButton}" Margin="0,4,0,0" Content="Spur entfernen"
                                                            Command="{Binding DataContext.Mixer.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Width="1" Margin="4,0,10,0" Fill="#3A3E48" />
                                <ItemsControl ItemsSource="{Binding Mixer.Groups}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Strip}" BorderBrush="#9E9E9E" Background="#30333B">
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource StripName}" Text="{Binding Name}" ToolTip="Gruppenname (zum Ändern anklicken)" />
                                                    <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Gruppe" />
                                                    <Slider Style="{StaticResource StripFader}" Margin="0,44,0,0" Value="{Binding VolumeDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                            ToolTip="Gruppen-Fader: regelt alle zugeordneten Spuren gemeinsam" />
                                                    <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                                    <ToggleButton Style="{StaticResource StripToggle}" Margin="0,4,0,0" HorizontalAlignment="Center" Content="M"
                                                                  IsChecked="{Binding Mute}" ToolTip="Alle Spuren der Gruppe stumm" />
                                                    <Button Style="{StaticResource StripButton}" Margin="0,70,0,0" Content="Gruppe entfernen"
                                                            Command="{Binding DataContext.Mixer.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,0,10,0" Padding="8,4" VerticalAlignment="Top" Content="+ Gruppe" Command="{Binding Mixer.AddGroupCommand}" />
                                <Rectangle Width="1" Margin="0,0,10,0" Fill="#3A3E48" />
                                <Border Style="{StaticResource Strip}" BorderBrush="#BA68C8" Background="#2E2A36" DataContext="{Binding Mixer.HallBus}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StripTitle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Rückweg" />
                                        <Slider Style="{StaticResource StripFader}" Margin="0,44,0,0" Value="{Binding ReturnDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                ToolTip="Lautstärke des Hall-Anteils, der zur Summe zurückkommt" />
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                        <UniformGrid Margin="0,8,0,0" Columns="2">
                                            <StackPanel ToolTip="Raumgröße – Doppelklick für 60 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="60" Value="{Binding RoomSize}" Accent="#6A1B9A" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Raum" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Dämpfung – Doppelklick für 40 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="40" Value="{Binding Damping}" Accent="#EF6C00" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Dämpf." />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Strip}" BorderBrush="#FFB74D" Background="#33302A" DataContext="{Binding Mixer.EchoBus}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StripTitle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Rückweg" />
                                        <Slider Style="{StaticResource StripFader}" Margin="0,10,0,0" Height="110" Value="{Binding ReturnDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                ToolTip="Lautstärke des Echo-Anteils, der zur Summe zurückkommt" />
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                        <UniformGrid Margin="0,6,0,0" Columns="2">
                                            <StackPanel ToolTip="Verzögerung links in ms – Doppelklick für 375 ms">
                                                <controls:Knob Width="30" Height="30" Minimum="20" Maximum="2000" DefaultValue="375" Value="{Binding TimeLeft}" Accent="#4FC3F7" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Zeit L" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Verzögerung rechts in ms – Doppelklick für 500 ms">
                                                <controls:Knob Width="30" Height="30" Minimum="20" Maximum="2000" DefaultValue="500" Value="{Binding TimeRight}" Accent="#F06292" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Zeit R" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Rückkopplung – Doppelklick für 35 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="90" DefaultValue="35" Value="{Binding Feedback}" Accent="#6A1B9A" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Rückk." />
                                            </StackPanel>
                                            <StackPanel ToolTip="Dämpfung – Doppelklick für 40 %">
                                                <controls:Knob Width="30" Height="30" Minimum="0" Maximum="100" DefaultValue="40" Value="{Binding Damping}" Accent="#EF6C00" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Dämpf." />
                                            </StackPanel>
                                        </UniformGrid>
                                        <CheckBox Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#C8CCD4" FontSize="11" Content="Ping-Pong" IsChecked="{Binding PingPong}" />
                                    </StackPanel>
                                </Border>
                                <Rectangle Width="1" Margin="4,0,10,0" Fill="#3A3E48" />
                                <Border Style="{StaticResource Strip}" Width="110" BorderBrush="#FF5252" Background="#33282A">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StripTitle}" Text="Master" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,4,0,0" Text="Summe" />
                                        <StackPanel Margin="0,44,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding Mixer.MasterMeterLeft, Mode=OneWay}" ToolTip="Pegel links" />
                                            <ProgressBar Style="{StaticResource Meter}" Margin="2,0,0,0" Value="{Binding Mixer.MasterMeterRight, Mode=OneWay}" ToolTip="Pegel rechts" />
                                            <Slider Style="{StaticResource StripFader}" Value="{Binding Mixer.MasterDb}" MouseDoubleClick="OnEqSliderDoubleClick"
                                                    ToolTip="Master-Fader: Gesamtlautstärke" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding Mixer.MasterVolumeText}" />
                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,8,0,2" Text="Master-EQ" />
                                        <UniformGrid Columns="3">
                                            <StackPanel ToolTip="Tiefen der Summe ±12 dB (120 Hz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqLow}" Accent="#E57373" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Tief" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Mitten der Summe ±12 dB (1 kHz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqMid}" Accent="#FFD54F" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Mitte" />
                                            </StackPanel>
                                            <StackPanel ToolTip="Höhen der Summe ±12 dB (8 kHz) – Doppelklick = 0">
                                                <controls:Knob Width="26" Height="26" Minimum="-12" Maximum="12" DefaultValue="0" Value="{Binding Mixer.MasterEqHigh}" Accent="#4FC3F7" />
                                                <TextBlock Style="{StaticResource StripSmall}" Text="Höhe" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel Margin="0,4,0,0" ToolTip="Summen-Kompressor: verdichtet den Gesamtklang (0 % = aus) – Doppelklick = aus">
                                            <controls:Knob Width="26" Height="26" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding Mixer.MasterCompression}" Accent="#FF8A65" />
                                            <TextBlock Style="{StaticResource StripSmall}" Text="Komp." />
                                        </StackPanel>
                                        <CheckBox Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="#C8CCD4" FontSize="11" Content="Limiter"
                                                  IsChecked="{Binding Mixer.MasterLimiter}" ToolTip="Begrenzer: verhindert, dass die Summe übersteuert (empfohlen)" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Spuransicht -->
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1B1D23">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Background="#22252C">
                                    <Border Height="22" Background="#25282E" BorderBrush="#30343D" BorderThickness="0,0,1,0">
                                        <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0AA" Text="Spuren" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Mixer.Tracks}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="76" Padding="8,6" BorderBrush="#30343D" BorderThickness="0,0,1,1" Background="#22252C">
                                                    <DockPanel>
                                                        <Rectangle DockPanel.Dock="Left" Width="4" Fill="{Binding Color}" RadiusX="2" RadiusY="2" />
                                                        <StackPanel Margin="8,0,0,0">
                                                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                                <ToggleButton Style="{StaticResource StripToggle}" Content="M" IsChecked="{Binding Mute}" ToolTip="Stumm (Mute)" />
                                                                <ToggleButton Style="{StaticResource StripToggle}" Margin="4,0,0,0" Content="S" IsChecked="{Binding Solo}" ToolTip="Solo" />
                                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0AA" FontFamily="Consolas"
                                                                           Text="{Binding VolumeText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <controls:TimelineView x:Name="Timeline" Grid.Column="1"
                                                       Tracks="{Binding Mixer.Tracks}"
                                                       Version="{Binding Mixer.TimelineVersion}"
                                                       PlayheadFrame="{Binding Mixer.PlayheadFrame}"
                                                       SampleRate="{Binding Mixer.SampleRate}"
                                                       SelectedClip="{Binding Mixer.SelectedClip}"
                                                       FollowPlayhead="{Binding Mixer.IsPlaying}"
                                                       SeekCommand="{Binding Mixer.SeekCommand}"
                                                       MoveClipCommand="{Binding Mixer.MoveClipCommand}"
                                                       SelectClipCommand="{Binding Mixer.SelectClipCommand}"
                                                       OpenClipCommand="{Binding Mixer.OpenClipInEditorCommand}"
                                                       SetLoopCommand="{Binding Mixer.SetLoopRangeCommand}"
                                                       Bpm="{Binding Mixer.Bpm}"
                                                       BeatsPerBar="{Binding Mixer.BeatsPerBar}"
                                                       ShowGrid="{Binding Mixer.ShowGrid}"
                                                       IsLooping="{Binding Mixer.IsLooping}"
                                                       LoopStart="{Binding Mixer.LoopStart}"
                                                       LoopEnd="{Binding Mixer.LoopEnd}" />
                            </Grid>
                        </ScrollViewer>

                        <Border Background="#AA000000" Visibility="{Binding Mixer.IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="260" Height="6" IsIndeterminate="True" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="White" Text="{Binding Mixer.StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
