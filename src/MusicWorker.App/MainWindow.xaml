                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Strip}" BorderBrush="{Binding Color}">
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource StripName}" Text="{Binding Name}" ToolTip="Spurname (zum Ändern anklicken)" />
