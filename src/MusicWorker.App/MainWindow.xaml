                                                                <controls:Knob Width="24" Height="24" Minimum="20" Maximum="500" DefaultValue="20" Value="{Binding HighPassHz}" Accent="#81C784" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="{Binding HighPassText}" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Kompressor: gleicht Lautstärkeschwankungen aus (0 % = aus) – Doppelklick = aus">
                                                                <controls:Knob Width="24" Height="24" Minimum="0" Maximum="100" DefaultValue="0" Value="{Binding Compression}" Accent="#FF8A65" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="Komp." />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,2" Text="Absenken durch" />
                                                        <ComboBox FontSize="10" DisplayMemberPath="Name" SelectedItem="{Binding DuckSource}"
                                                                  ItemsSource="{Binding DataContext.Mixer.DuckChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  ToolTip="Auto-Absenkung: Diese Spur wird leiser, sobald die gewählte Spur (z. B. Sprache) spielt" />
                                                        <UniformGrid Margin="0,4,0,0" Columns="2">
                                                            <StackPanel ToolTip="Wie stark abgesenkt wird – Doppelklick für 12 dB">
                                                                <controls:Knob Width="24" Height="24" Minimum="0" Maximum="30" DefaultValue="12" Value="{Binding DuckAmount}" Accent="#9575CD" />
                                                                <TextBlock Style="{StaticResource StripSmall}" Text="{Binding DuckAmountText}" />
                                                            </StackPanel>
                                                            <StackPanel ToolTip="Schwelle: ab diesem Pegel der Quellspur wird abgesenkt – Doppelklick für -40 dB">
