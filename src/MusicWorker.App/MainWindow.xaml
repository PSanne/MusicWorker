                                                    </StackPanel>
                                                    <StackPanel Visibility="{Binding DataContext.Mixer.ShowInserts, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource StripSmall}" Margin="0,6,0,2" Text="EQ" />
