                                                            ToolTip="Gruppen-Fader: regelt alle zugeordneten Spuren gemeinsam" />
                                                    <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
                                                    <ToggleButton Style="{StaticResource StripToggle}" Margin="0,4,0,0" HorizontalAlignment="Center" Content="M"
