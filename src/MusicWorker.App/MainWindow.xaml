                                                    <TextBlock Style="{StaticResource StripText}" Text="{Binding PanText}" />
                                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Meter, Mode=OneWay}" />
                                                        <Slider Style="{StaticResource StripFader}" Value="{Binding VolumeDb}" MouseDoubleClick="OnEqSliderDoubleClick" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource StripText}" FontFamily="Consolas" Text="{Binding VolumeText}" />
