<Window x:Class="MusicWorker.App.Views.ParametersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" MinWidth="420">
        <TextBlock x:Name="IntroText" MaxWidth="460" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel x:Name="Host" />
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="88" Content="OK" IsDefault="True" Click="OnOkClick" />
            <Button Width="88" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
