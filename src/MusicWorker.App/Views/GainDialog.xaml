<Window x:Class="MusicWorker.App.Views.GainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lautstärke ändern"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Verstärkung in Dezibel (dB):" />
        <DockPanel Margin="0,8,0,0">
            <TextBox x:Name="ValueBox"
                     DockPanel.Dock="Right"
                     Width="64"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding Value, ElementName=GainSlider, StringFormat=F1}" />
            <Slider x:Name="GainSlider"
                    Width="280"
                    Minimum="-24"
                    Maximum="24"
                    Value="0"
                    SmallChange="0.5"
                    LargeChange="3"
                    TickFrequency="6"
                    TickPlacement="BottomRight" />
        </DockPanel>
        <TextBlock Margin="0,8,0,0"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   MaxWidth="350"
                   Text="Positive Werte machen lauter, negative leiser. +6 dB ≈ doppelte Amplitude. Ohne Auswahl wird die ganze Datei geändert." />
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="88" Content="OK" IsDefault="True" Click="OnOkClick" />
            <Button Width="88" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
