<Window x:Class="MusicWorker.App.Views.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MusicWorker.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EqualizerViewModel}"
        Title="Equalizer – 15 Bänder"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="BandSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="200" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="TickPlacement" Value="Both" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="BandLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Kopfzeile: Voreinstellungen, Zurücksetzen, Vorhören -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" MinWidth="150" Padding="10,3"
                    Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}"
                    ToolTip="Spielt die Auswahl (oder ab dem Cursor) in Schleife – jede Reglerbewegung ist sofort hörbar." />
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Voreinstellung:" />
                <ComboBox Width="170" Margin="8,0,8,0" ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                <Button Padding="10,2" Content="Zurücksetzen" Command="{Binding ResetCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Fußzeile -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Width="96" Content="Anwenden" IsDefault="True" Click="OnApplyClick" />
                <Button Width="96" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" />
            </StackPanel>
            <StackPanel>
                <CheckBox Content="Übersteuerung verhindern (Pegel bei Bedarf auf -1 dB absenken)"
                          IsChecked="{Binding PreventClipping}" />
                <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="520"
                           Text="Doppelklick auf einen Regler setzt ihn auf 0 dB. Ohne Auswahl wirkt der Equalizer auf die ganze Datei." />
            </StackPanel>
        </DockPanel>

        <!-- Regler -->
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="56" ToolTip="Vorverstärkung vor dem Equalizer">
                <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding PreampDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                <Slider Style="{StaticResource BandSlider}" Value="{Binding PreampDb}" MouseDoubleClick="OnSliderDoubleClick" />
                <TextBlock Style="{StaticResource BandLabel}" FontWeight="SemiBold" Text="Pegel" />
            </StackPanel>

            <Border Width="1" Margin="8,0" Background="LightGray" />

            <ItemsControl ItemsSource="{Binding Bands}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="40" ToolTip="{Binding ToolTip}">
                            <TextBlock Style="{StaticResource ValueLabel}" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" />
                            <Slider Style="{StaticResource BandSlider}" Value="{Binding GainDb}" MouseDoubleClick="OnSliderDoubleClick" />
                            <TextBlock Style="{StaticResource BandLabel}" Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="6,19,0,0" Height="200" VerticalAlignment="Top">
                <TextBlock VerticalAlignment="Top" FontSize="10" Foreground="Gray" Text="+12 dB" />
                <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="Gray" Text="0 dB" />
                <TextBlock VerticalAlignment="Bottom" FontSize="10" Foreground="Gray" Text="-12 dB" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
