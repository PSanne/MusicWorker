<Window x:Class="MusicWorker.App.Views.TempoPitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo &amp; Tonhöhe"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Tempo (ohne die Tonhöhe zu verändern):" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Text="%" />
            <TextBox x:Name="TempoBox" DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding Value, ElementName=TempoSlider, StringFormat=0}" />
            <Slider x:Name="TempoSlider" Width="300" Minimum="50" Maximum="200" Value="100"
                    SmallChange="1" LargeChange="10" TickFrequency="25" TickPlacement="BottomRight"
                    IsMoveToPointEnabled="True" />
        </DockPanel>
        <TextBlock Margin="0,2,0,0" Foreground="Gray" FontSize="11"
                   Text="50 % = halb so schnell · 100 % = unverändert · 200 % = doppelt so schnell" />

        <TextBlock Margin="0,16,0,0" Text="Tonhöhe (ohne das Tempo zu verändern):" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Text="Halbtöne" />
            <TextBox x:Name="PitchBox" DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding Value, ElementName=PitchSlider, StringFormat=+0.#;-0.#;0}" />
            <Slider x:Name="PitchSlider" Width="300" Minimum="-12" Maximum="12" Value="0"
                    SmallChange="1" LargeChange="2" TickFrequency="1" TickPlacement="BottomRight"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
        </DockPanel>
        <TextBlock Margin="0,2,0,0" Foreground="Gray" FontSize="11"
                   Text="12 Halbtöne = 1 Oktave · 7 Halbtöne = Quinte · -12 = eine Oktave tiefer" />

        <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap" MaxWidth="420"
                   Text="Ohne Auswahl wird die ganze Datei bearbeitet. Bei langen Dateien kann die Berechnung einige Sekunden dauern." />

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Padding="10,2" Content="Zurücksetzen" Click="OnResetClick" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="88" Content="OK" IsDefault="True" Click="OnOkClick" />
                <Button Width="88" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
