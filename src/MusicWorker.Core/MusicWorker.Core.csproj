<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plattformunabhängiger Kern: Audio-Daten, Bearbeitung, Effekte, Rückgängig/Wiederholen.
       Enthält bewusst keine Windows- oder UI-Abhängigkeiten, damit alles testbar bleibt. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MusicWorker.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SoundFont-Synthesizer (reines C#, plattformunabhängig, MIT-Lizenz) -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
  </ItemGroup>

</Project>
